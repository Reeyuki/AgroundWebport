	<animation id="house_door.closed" x="1" count="1" />
	<animation id="house_door.closing" x="1" count="8" reverse="true" />
	<animation id="house_door.opening" x="1" count="8" />
	<action>
		house_upgrades = ["storehouse", "farm", "stall", "dockhouse"];
		house_npcs = ["builder", "miner", "farmer", "trader"];
		function checkHouseUpgrade(e){
			var s = e.value; if(house_upgrades.indexOf(s.info.id) != -1) s.setInfo(getStructure(s.info.id+"2"));
		}
		function checkHouseUpgradeNPC(e){
			var n = e.value; if(house_npcs.indexOf(n.info.id) != -1) setNPCUpgrade(n, n.info.id+".upgrade", 3, 2);
		}
		function setNPCUpgrade(o, tile, speed, mine){
			o.setTileId(tile); o.speed = speed; if(o.idle != null &amp;&amp; o.idle.minePower > 0) o.idle.minePower = mine;
		}
	</action>
	<structure id="house" tile="house" sleep="true" powered="true" name="enter" nightAnimation="house.night" behind="true" repairType="mechanic">
		<tile id="house" animation="house_door.closed" fps="15" y="0" />
		<over><action>var door = this.getTileById("house"); if(door != null) door.playAnimation("house_door.opening", false)</action></over>
		<out><action>var door = this.getTileById("house"); if(door != null) door.playAnimation("house_door.closing", false)</action></out>
		<operate>
			<choose>
				<section if="this.isPowered()">
					<choose if="area.id == 'start' && !getFlag('bombardment') && !getFlag('final_boss_defeat')">
						<scene id="house" show="first" with="fade" if="!getFlag('house_intro')" showToAll="true">
							<action>setFlag('house_intro', true);</action>
						</scene>
					</choose><action>player.restoreHealth();</action>
				</section>
				<dialogue section="warning" id="not_powered_house" />
			</choose>
			<action>player.restoreStamina();</action><save sleep="true" />
		</operate>
		<light tile="light.large" color="fae1b5" offsetX="30" offsetY="45" ifAnim="house.night.on" />
		<addedToArea><displayAction>
			for(h in house_upgrades) for(s in area.getStructuresById(h)) s.setInfo(getStructure(h+"2"));
			for(n in house_npcs) for(o in area.getObjectsById(n)) setNPCUpgrade(o, n+".upgrade", 3, 2);
			area.addEventListener("add_structure", checkHouseUpgrade); area.objects.addEventListener("add_object", checkHouseUpgradeNPC);
		</displayAction></addedToArea>
		<removedFromArea><displayAction>
			for(h in house_upgrades) for(s in area.getStructuresById(h)) s.setInfo(getStructure(h));
			for(n in house_npcs) for(o in area.getObjectsById(n)) setNPCUpgrade(o, n, 4, 1);
			area.removeEventListener("add_structure", checkHouseUpgrade); area.objects.removeEventListener("add_object", checkHouseUpgradeNPC);
		</displayAction></removedFromArea>
	</structure>
	
