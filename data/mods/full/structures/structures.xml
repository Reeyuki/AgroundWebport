	<structure id="com_station" width="32" height="32" image="com_station.png" name="operate" repairType="mechanic">
		<operate>
			<section if="getFlag('final_boss_defeat') && !getFlag('colony_world')">
				<action>setFlag('colony_world', true);</action><dialogue title="mechanic.com_station_incoming{planet:[text=system.planet.colony]}" />
				<scene id="colony" show="com_station" with="fade" /><stop />
			</section>
			<window type="nav" system="area.planet.system"><section if="planetName != null">
				<dialogue eval="'mechanic.com_station1{planet:'+planetName+'}'" />
				<choose>
					<dialogue section="mechanic" id="com_station_self" if="planet == area.planet" />
					<section if="planetXml.get('id') == 'colony' && getFlag('final_boss_defeat')">
						<dialogue section="colony" id="com_station1" />
					  <choose>
						<dialogue section="colony" id="com_station4" if="!getFlag('colony')"/>
						<dialogue section="colony" id="win3" />
					  </choose>
					</section>
					<section if="planetXml.get('id') == 'unnature'">
						<dialogue section="mechanic" id="com_station2.5" />
						<dialogue section="unnature" id="com_station" />
					</section>
					<section if="planetXml.get('id') == 'earth'">
						<dialogue section="mechanic" id="com_station2.5" />
						<section if="!getFlag('call_earth')">
							<action>setFlag('call_earth', true)</action>
							<call id="mechanic" incoming="true" />
							<dialogue section="mechanic" id="com_station3" speaker="mechanic" />
							<dialogue section="mechanic" id="com_station4" speaker="player" />
							<dialogue section="mechanic" id="com_station5" speaker="mechanic" />
							<dialogue section="mechanic" id="com_station6" speaker="mechanic" />
							<call id="mechanic" end="true" />
						</section>
					</section>
					<dialogue section="mechanic" id="com_station2" />
				</choose>
			</section></window>
		</operate>
	</structure>
	
