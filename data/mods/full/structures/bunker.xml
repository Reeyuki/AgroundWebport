		<item id="missile" min="5" max="10" />
		<item id="chainsaw" min="1" max="1" />
		<item id="net" min="10" max="15" />
		<item id="trap" min="5" max="10" />
		<item id="map" min="1" max="1" if="player.getItemCount('map') == 0" />
		<item id="clock" min="1" max="1" if="player.getItemCount('clock') == 0" />
		<buy type="equipment" /><buy type="tool" /><buy type="object" />
		<over><action>this.loopAnimation("talk")</action></over>
		<out><action>this.loopAnimation("idle")</action></out>
		<operate><run procedure="sci1_coin_quest" /></operate>
		<light tile="light.default" color="9ce1eb" offsetX="16" offsetY="11" />
	</structure>
	<tile id="bunker_merchant.ore" sheet="underground.6" x="10" />
	<animation id="bunker_merchant.ore.idle" count="6" />
	<animation id="bunker_merchant.ore.open" x="14" count="4" />
	<animation id="bunker_merchant.ore.close" x="14" count="4" reverse="true" />
	<animation id="bunker_merchant.ore.talk" x="6" count="8"><append tile="bunker_market" animation="bunker_market.screen" behind="true" /></animation>
	<npc id="bunker.ore_merchant" tile="empty" indicatorY="-3">
		<operate><choose if="!getFlag('final_boss_defeat')">
			<quest if="!getFlag('ore_merchant')" />
			<choose if="!isBombardment(player) || player.hasQuest('bunker')">
				<quest if="!player.hasQuest('bunker')" />
				<quest if="player.canCompleteQuest('bunker')" />
				<quest if="player.questComplete('bunker') && !player.hasQuest('station')" />
				<quest if="player.canCompleteQuest('station')" />
			</choose>
		</choose></operate>
	</npc>
	<structure id="bunker_merchant.ore" tile="bunker_merchant.ore" type="market" restock="5000" name="mineral_market" fullHeight="true" speechX="-8">
		<item id="wood" min="10" max="30" />
		<item id="coal" min="10" max="20" />
		<item id="iron" min="10" max="30" />
		<item id="quartz" min="5" max="5" />
		<item id="gold" min="5" max="5" />
		<item id="diamond" min="5" max="5" />
		<item id="iron_bar" min="5" max="5" />
		<item id="steel_bar" min="5" max="5" />
		<item id="sulfur" min="10" max="20" />
		<item id="refined_oil" min="5" max="5" />
		<item id="silicon" min="5" max="10" />
		<item id="titanium" min="10" max="20" />
		<item id="uranium" min="5" max="5" />
		<buy type="resource" />
		<over><play object="this" animation="open" /><action>this.loopAnimation("talk")</action></over>
		<out><play object="this" animation="close" /><action>this.loopAnimation("idle")</action></out>
		<addedToArea>
			<set id="npc" value="area.getNPC('bunker.ore_merchant')" /><choose>
				<object id="bunker.ore_merchant" x="this.tile_x" y="this.tile_y" if="npc == null" />
				<move object="npc" x="this.tile_x" y="this.tile_y" />
			</choose>
		</addedToArea>
		<operate><section if="!getFlag('final_boss_defeat')">
			<section if="!getFlag('ore_merchant')">
				<action>setFlag('ore_merchant', true)</action><dialogue section="merchants" id="intro1" speaker="player" />
				<dialogue section="merchants" id="intro2" /><dialogue section="merchants" id="intro3" /><stop />
			</section>
			<section if="!isBombardment(player) || player.hasQuest('bunker')">
				<section if="!player.hasQuest('bunker')">
					<dialogue section="merchants" id="bunker1" /><dialogue section="merchants" id="bunker2" /><quest id="bunker" /><stop />
				</section>
				<section if="player.canCompleteQuest('bunker')">
					<complete quest="bunker" /><dialogue section="merchants" id="bunker3" />
					<action>player.addMultipleItems("bunker_blueprint", 1, "bunker_kitchen_blueprint", 1, "bunker_depot_blueprint", 1, "hydroponics_blueprint", 1, "bunker_factory_blueprint", 1, "bunker_farm_blueprint", 1)</action><stop />
				</section>
				<section if="player.questComplete('bunker') && !player.hasQuest('station')">
					<dialogue section="merchants" id="station1" /><dialogue section="merchants" id="station2" /><quest id="station" /><stop />
				</section>
				<section if="player.canCompleteQuest('station')">
					<complete quest="station" /><dialogue section="merchants" id="station3" /><dialogue section="merchants" id="station4" />
					<action>player.addMultipleItems("small_module_blueprint", 1, "large_module_blueprint", 1, "station_dock_blueprint", 1, "connector_module_blueprint", 1)</action><stop />
				</section>
			</section>
			</section><run procedure="sci1_coin_quest" />
		</operate>
		<light tile="light.default" color="9ce1eb" offsetX="16" offsetY="11" />
	</structure>
