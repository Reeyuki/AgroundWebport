<?xml version="1.0" encoding="utf-8" ?>
<data>
	<quest id="bunker" exp="1000"><item id="magnegem" count="10" /></quest>
	<quest id="station" exp="1000"><item id="exotic_matter" count="4" /></quest>
	
	<include id="underground.xml" />
	<tile id="bunker" sheet="underground.1" />
	<animation id="bunker.off" x="0" count="1" />
	<animation id="bunker.on" x="9" count="4" />
	<animation id="bunker_door.closed" x="1" count="4" />
	<animation id="bunker_door.closing" x="5" count="4" reverse="true" />
	<animation id="bunker_door.opening" x="5" count="4" />
	
	<structure id="bunker" tile="bunker" sleep="true" powered="true" name="enter" behind="true" fullHeight="true" repairType="mechanic">
		<tile id="bunker" animation="bunker_door.closed" fps="15" y="0" />
		<over><action>var door = this.getTileById("bunker"); if(door != null) door.playAnimation("bunker_door.opening", false)</action></over>
		<out><action>var door = this.getTileById("bunker"); if(door != null) door.playAnimation("bunker_door.closing", false, function(p){p.playAnimation("bunker_door.closed", true);})</action></out>
		<operate>
			<choose>
				<section if="this.isPowered()">
					<action>player.restoreHealth();</action>
				</section>
				<dialogue section="warning" id="not_powered_house" />
			</choose>
			<action if="var b = this.getBounds(); b.inflate(Tile.SIZE*3, 0); var s = area.getStructure(b, true, function(s){return s.info.id == 'o2_generator';}); return s != null && s.isPowered()">player.restoreOxygen();</action>
			<action>player.restoreStamina();</action><save sleep="true" />
		</operate>
		<light tile="light.large" color="9ce1eb" offsetX="30" offsetY="45" />
	</structure>
	<item id="bunker_blueprint" type="blueprint" cost="7500" weight="0" icon="blueprint.ico">
		<action id="build" structure="bunker" underground="true">
			<item id="steel_bar" count="16" /><item id="silicon" count="2" />
		</action>
	</item>

	<tile id="bunker_kitchen" sheet="underground.2" offsetX="-3" />
	<animation id="bunker_kitchen.off" x="5" count="1" />
	<animation id="bunker_kitchen.on" x="0" count="1" />
	<animation id="bunker_kitchen.over" x="1" count="4" />
	<structure id="bunker_kitchen" tile="bunker_kitchen" type="crafting" powered="true" name="kitchen" title="common.bunker_kitchen" display="bunker_kitchen" connectTo="bunker" fullHeight="true">
		<recipe type="kitchen3" />
		<recipe type="kitchen2" />
		<recipe type="kitchen" />
		<operate><section if="!this.isPowered()"><dialogue section="warning" id="not_powered" /><stop /></section></operate>
		<over><action>this.loopAnimation("over")</action></over>
		<out><action>this.loopAnimation("idle")</action></out>
		<light tile="light.default" color="9ce1eb" offsetX="20" offsetY="45" />
	</structure>
	<item id="bunker_kitchen_blueprint" type="blueprint" cost="7500" weight="0" icon="blueprint.ico">
		<action id="build" structure="bunker_kitchen" underground="true">
			<constraint enabled="s != null && s.info.id == 'bunker'" x="s.xPos+s.info.width" fail="warning.structure_adjacent_right{structure:[structure=bunker]}">
				s = area.getStructureInTile(tile_x-3, tile_y);
			</constraint>
			<item id="steel_bar" count="16" /><item id="silicon" count="2" />
		</action>
	</item>
		
	<tile id="bunker_depot" sheet="underground.3" />
	<animation id="bunker_depot.idle" equals="single" />
	<animation id="bunker_depot.closing" count="8" reverse="true" />
	<animation id="bunker_depot.opening" count="8" />
	<structure id="bunker_depot" tile="bunker_depot" type="storehouse" main="true" name="enter" title="common.bunker_depot" fullHeight="true" powered="true" repairType="mechanic">
		<operate>
			<action if="!player.hasItemStorehouse('stone_pickaxe')">this.inventory.addItems(Item.get("stone_pickaxe"), 1)</action>
			<action if="!player.hasItemStorehouse('stone_axe')">this.inventory.addItems(Item.get("stone_axe"), 1)</action>
		</operate>
		<light tile="light.default" color="9ce1eb" offsetX="33" offsetY="45" />
	</structure>
	<item id="bunker_depot_blueprint" type="blueprint" cost="7500" weight="0" icon="blueprint.ico">
		<action id="build" structure="bunker_depot" underground="true">
			<item id="steel_bar" count="16" /><item id="silicon" count="2" />
		</action>
	</item>
		
	<tile id="hydroponics" sheet="underground.4" />
	<animation id="hydroponics.off" x="3" count="1" />
	<animation id="hydroponics.on" x="5" count="6" />
	<animation id="hydroponics.apples" x="0" count="2" />
	<animation id="hydroponics.apples.idle" x="2" count="1" />
	<animation id="hydroponics.sugar" x="11" count="2" />
	<animation id="hydroponics.sugar.idle" x="13" count="1" />
	<animation id="hydroponics.wheat" x="14" count="2" />
	<animation id="hydroponics.wheat.idle" x="16" count="1" />
	<animation id="hydroponics.cotton" x="17" count="2" />
	<animation id="hydroponics.cotton.idle" x="19" count="1" />
	<animation id="hydroponics.rice" x="20" count="2" />
	<animation id="hydroponics.rice.idle" x="22" count="1" />
	<animation id="hydroponics.pumpkin" x="23" count="2" />
	<animation id="hydroponics.pumpkin.idle" x="25" count="1" />
	<animal id="hydroponics.orchard_seed" flip="false" includeActions="false" growthAnim="hydroponics.apples">
		<farmable item="wood" min="1" max="4" time="20" />
		<farmable item="fruit" min="1" max="4" time="20" />
		<tile id="hydroponics" animation="hydroponics.apples.idle" x="0" y="0" />
	</animal>
	<animal id="hydroponics.sugar_seed" flip="false" includeActions="false" growthAnim="hydroponics.sugar">
		<farmable item="sugar" min="1" max="4" time="20" />
		<tile id="hydroponics" animation="hydroponics.sugar.idle" x="0" y="0" />
	</animal>
	<animal id="hydroponics.wheat_seed" flip="false" includeActions="false" growthAnim="hydroponics.wheat">
		<farmable item="wheat" min="2" max="8" time="20" />
		<tile id="hydroponics" animation="hydroponics.wheat.idle" x="0" y="0" />
	</animal>
	<animal id="hydroponics.cotton_seed" flip="false" includeActions="false" growthAnim="hydroponics.cotton">
		<farmable item="cotton" min="2" max="8" time="20" />
		<tile id="hydroponics" animation="hydroponics.cotton.idle" x="0" y="0" />
	</animal>
	<animal id="hydroponics.rice_seed" flip="false" includeActions="false" growthAnim="hydroponics.rice">
		<farmable item="rice" min="1" max="4" time="30" />
		<tile id="hydroponics" animation="hydroponics.rice.idle" x="0" y="0" />
	</animal>
	<animal id="hydroponics.pumpkin_seed" flip="false" includeActions="false" growthAnim="hydroponics.pumpkin">
		<farmable item="pumpkin" min="1" max="4" time="20" />
		<tile id="hydroponics" animation="hydroponics.pumpkin.idle" x="0" y="0" />
	</animal>
	<structure id="hydroponics" tile="hydroponics" animals="1" type="pen" name="crop" prefix="hydroponics." powered="true" selectAnimal="structure.plant" fullHeight="true" attachFarm="bunker_farm">
		<sprite>
			<tile x="4" showUnpowered="false" /><animal i="0" showUnpowered="false" /><self />
		</sprite>
		<animal id="orchard_seed" />
		<animal id="sugar_seed" />
		<animal id="wheat_seed" />
		<animal id="cotton_seed" />
		<animal id="rice_seed" />
		<animal id="pumpkin_seed" />
		<light tile="light.default" color="f9f5c8" offsetX="16" offsetY="16" />
		<operate><dialogue section="warning" id="not_powered" if="!this.isPowered()" /></operate>
	</structure>
	<item id="hydroponics_blueprint" type="blueprint" cost="7500" weight="0" icon="blueprint.ico">
		<action id="build" structure="hydroponics" underground="true">
			<item id="steel_bar" count="16" /><item id="silicon" count="2" />
		</action>
	</item>

	<tile id="bunker_factory" sheet="underground.5" />
	<animation id="bunker_factory.off" x="8" count="1" />
	<animation id="bunker_factory.on" x="9" count="1" />
	<animation id="bunker_factory.open" x="9" count="8" />
	<animation id="bunker_factory.close" x="9" count="8" reverse="true" />
	<animation id="bunker_factory.operate" x="0" count="8" />
	<structure id="bunker_factory" tile="bunker_factory" type="crafting" name="factory" display="bunker_factory" title="common.bunker_factory" powered="true" fullHeight="true" repairType="mechanic">
