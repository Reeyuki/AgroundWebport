<?xml version="1.0" encoding="UTF-8"?>
<data>
  <include id="enemies.xml" />

  <tile id="spindle_driller" sheet="enemies.1" offsetX="2"/>
  <animation id="spindle_driller.walk" x="0" count="6" />
  <animation id="spindle_driller.attack" x="6" count="3" repeat="2"/>
  <animation id="spindle_driller.dig" equals="spindle_driller.attack" />
  <animation id="spindle_driller.hit" x="10" count="1" length="3"/>
  <enemy id="spindle_driller" tile="spindle_driller" health="60" defense="8" damage="40" type="wyrm" eatTile="hidden_world.stone" attack_sfx="scrab_attack" element="earth">
    <lootSet><loot id="carapace" /></lootSet>
    <lootSet><loot id="exotic_gas" /></lootSet>
    <sound id="death" value="razor_bug_death" />
  </enemy>

  <tile id="octoblaster" sheet="enemies.2" />
  <animation id="octoblaster.idle" x="0" count="6"/>
  <animation id="octoblaster.walk" equals="octoblaster.idle" />
  <animation id="octoblaster.swim" equals="octoblaster.idle" />
  <animation id="octoblaster.hit" x="6" count="1" length="3" />
  <animation id="octoblaster.blast" x="7" count="6"/>
  <animation id="octoblaster.attack" x="0" count="6">
    <append tile="octoblaster" animation="octoblaster.blast" />
  </animation>
  <tile id="octoblaster_projectile" sheet="enemies.3" />
  <animation id="octoblaster.projectile" x="0" count="5" />
  <animation id="octoblaster.projectile.impact" x="5" count="5" />
  <enemy id="octoblaster" tile="octoblaster" health="50" defense="7" range="10" type="underwater" element="water">
    <loot id="exotic_gas" />
    <attack type="projectile" damage="30" range="6" animation="attack" boundsY="-16" height="16">
      <projectile tile="octoblaster_projectile" animation="octoblaster.projectile" speed="4" glow="true" fire_sfx="fireball" knockback="5" underwater="true" offsetY="-2">
        <hitEffect tile="octoblaster_projectile" animation="octoblaster.projectile.impact" color="b8fff4" /><light tile="light.small" color="b8fff4" />
      </projectile>
    </attack>
  </enemy>

  <enemy id="wyrm_hidden_world" extends="wyrm" eatTile="hidden_world.dirt" friendly="true"/>

  <quest id="teacher.monolith" exp="1000">
    <script id="player.areas.get('hidden_world').getStructureById('hidden_world.monolith') == null?1:0" tile="bone_shard.ico" name="quests.activate_monoliths" count="1" />
  </quest>
	
  <structure id="hidden_world.monolith" tile="depths.monolith" name="activate" animation="depths.monolith.off">
    <operate>
      <choose>
        <window type="prompt" message="structure.activate" item="'bone_shard'" if="player.getItemCount('bone_shard') > 0">
          <item id="bone_shard" count="-1" />
          <play object="this" animation="activate" modal="true" />
          <structure id="depths.monolith" x="this.xPos/Tile.SIZE" y="this.yPos/Tile.SIZE" />
          <object id="draconian_teacher" x="this.xPos/Tile.SIZE" y="this.yPos/Tile.SIZE" /><set id="this" value="draconian_teacher" />
          <facing object="this" dir="right" /><move object="player" to="this" />
        </window>
        <section>
          <dialogue section="structure" id="activate_fail" />
          <quest id="teacher.monolith" if="!player.hasQuest('teacher.monolith')"/>
        </section>
      </choose>
    </operate>
  </structure>

  <include id="structures.xml" />
  <tile id="holo_projector" sheet="structures.2" />
  <animation id="holo_projector.idle" x="0" count="8" />
  <animation id="holo_projector.active" x="8" count="8" repeat="4"/>

  <recipe id="fuel_exotic_gas" fuel="200" type="exo_fuel"><item id="exotic_gas" /></recipe>
  <structure id="holo_projector" tile="holo_projector" name="operate" type="fuelable" maxFuel="2000" title="quests.holo_projector" fps="10">
    <recipe type="exo_fuel" />
    <listItem icon="alien_locator.ico" title="hybrid.holo_projector" fail="this.getObjectInBounds('dragon_cruiser') != null?((this.getObjectInBounds('exo_fighter') != null || player.hasItemStorehouse('exo_fighter'))?'warning.fuel':'warning.no_item{item:[object=exo_fighter]}'):'warning.no_item{item:[object=dragon_cruiser]}'" if="!getFlag('final_boss_defeat')">
      <tooltip type="requires" requires="quests.requires">
        <option>
          <value icon="dragon_cruiser.ico" title="world.dragon_cruiser" if="this.getObjectInBounds('dragon_cruiser') != null" />
          <value icon="dragon_cruiser.ico" title="structure.place_in_lair{item:[object=dragon_cruiser]}" error="true" />
        </option>
        <option>
          <value icon="exo_fighter.ico" title="item.names.exo_fighter" if="this.getObjectInBounds('exo_fighter') != null" />
          <value icon="exo_fighter.ico" title="item.names.exo_fighter" if="player.hasItem('exo_fighter')" />
          <value icon="exo_fighter.ico" title="structure.place_in_lair{item:[item=exo_fighter]}" error="true" />
        </option>
        <requirement icon="exotic_matter.ico" title="common.fuel" count="this.fuel" of="2000" />
      </tooltip>
      <complete quest="holo_ships" useResources="false"/>
      <action>this.useFuel(2000); oldScale = getGameScale(); setGameScale(2);</action>
      <closeWindows /><pan toStructure="this" seconds="0.5" />
      <play object="this" animation="idle" modal="true" />
      <play object="this" animation="active" modal="true"/>
      <play object="this" animation="idle" loop="true" />
      <action>setGameScale(oldScale);</action>
      <scene id="teacher" show="projector" showToAll="true" with="fade" />
      <run procedure="hybrid_win" />
    </listItem>
  </structure>

  <structure id="magic_forge" extends="magic_forge">
    <item id="exotic_gas"/>
    <item id="fire_book" />
    <item id="ice_book" />
    <item id="water_book" />
    <item id="plant_book" />
    <item id="earth_book" />
  </structure>

  <tile id="bombardment_shield" sheet="structures.1" />
  <animation id="bombardment_shield.idle" x="0" count="6" glow="true"/>

  <structure id="bombardment_shield" tile="bombardment_shield" name="operate">
    <operate>
      <choose>
        <dialogue section="hybrid" id="prebomb" if="!getFlag('bombardment') || area.id != 'science2'" />
        <dialogue section="hybrid" id="bombardment" if="(o = player.areas.get('start.orbit').getObject('alien.bomber')) != null && o.enabled" />
        <dialogue section="hybrid" id="defeated" if="getFlag('bombardment')" />
      </choose>
    </operate>
    <light tile="light.large" color="4de7ff" offsetX="16"/>
  </structure>

  <structure id="drag_factory" extends="drag_factory" extendAppend="true">
    <listItem icon="mecha_dragon_ship.ico" title="structure.tooltip.evolve_mecha_dragon" fail="this.getObjectInBounds('mecha_dragon') != null?'warning.ingredients':'warning.no_item{item:[object=mecha_dragon]}'" if="player.hasQuest('mecha_dragon_ship')">
      <tooltip type="requires" requires="quests.requires">
        <option>
          <value icon="mecha_dragon.ico" title="item.names.mecha_dragon" if="this.getObjectInBounds('mecha_dragon') != null" />
          <value icon="mecha_dragon.ico" title="structure.place_in_lair{item:[object=mecha_dragon]}" error="true" />
        </option>
        <requirement icon="evo_gem.ico" title="item.names.evo_gem" count="player.getItemCountStorehouse('evo_gem')" of="1" />
        <requirement icon="blood_gem.ico" title="item.names.blood_gem" count="player.getItemCountStorehouse('blood_gem')" of="20" />
        <requirement icon="ship_parts.ico" title="item.names.ship_parts" count="player.getItemCountStorehouse('ship_parts')" of="10" />
        <requirement icon="exotic_matter.ico" title="item.names.exotic_matter" count="player.getItemCountStorehouse('exotic_matter')" of="1" />
      </tooltip>
      <section if="this.getObjectInBounds('dragon_ship') != null && this.getObjectInBounds('mecha_dragon_ship') != null"><dialogue section="warning" id="drag_ship_factory" /><stop /></section>
      <closeWindows />
      <item id="evo_gem" count="-1" storehouse="true" />
      <item id="blood_gem" count="-20" storehouse="true" />
      <item id="ship_parts" count="-10" storehouse="true" />
      <item id="exotic_matter" count="-1" storehouse="true" />
      <section with="fade">
        <action>oldScale = getGameScale(); setGameScale(2)</action><pan x="256-this.xPos-this.info.width*0.5" y="256-this.yPos" seconds="0" />
        <play object="this" animation="hidden" loop="true" />
        <set id="dragon" value="this.getObjectInBounds('mecha_dragon')" />
        <action>dragon.alpha = 0;</action><remove object="dragon" />
        <addAnimation to="this" modal="true">
          <add fps="10" id="bg" tile="drag_factory_bg" animation="single" />
          <add fps="10" id="first" tile="mecha_dragon" animation="mecha_dragon.idle" offsetX="-0.5" offsetY="-1" x="224" y="256" />
          <add fps="10" id="second" tile="mecha_dragon_ship" animation="mecha_dragon_ship.idle" offsetX="-0.5" offsetY="-1" x="272" y="256" alpha="0" />
          <add fps="10" id="fg" tile="drag_factory_fg" animation="single" />
          <wait seconds="1" />
          <play id="bg" animation="drag_factory_fx" />
          <play id="fg" animation="drag_factory_fx" modal="true" />
          <play id="bg" animation="drag_factory_fx_loop" loop="true" />
          <play id="fg" animation="drag_factory_fx_loop" loop="true" />
          <lerp id="first" alpha="0" seconds="0.5" />
          <lerp id="second" alpha="1" seconds="0.5" modal="true" />
          <wait seconds="1" />
          <action>this.runAnimation("single", null)</action>
          <lerp id="bg" alpha="0" seconds="1" />
          <lerp id="fg" alpha="0" seconds="1" modal="true" />
        </addAnimation>
        <object id="mecha_dragon_ship" x="(this.xPos+160)/Tile.SIZE" y="this.yPos/Tile.SIZE-4" />
        <action>mecha_dragon_ship.name = dragon.name; mecha_dragon_ship.inventory.copyFrom(dragon.inventory); mecha_dragon_ship.setFuel(Math.round(dragon.getFuelPercent()*mecha_dragon_ship.getMaxFuel()));</action>
        <play object="this" animation="snow" modal="true" /><action>player.checkQuestComplete(null);</action>
      </section>
      <section with="fade"><action>setGameScale(oldScale)</action><pan toObject="player" seconds="0" /></section>
    </listItem>
  </structure>
</data>
