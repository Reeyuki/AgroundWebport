  <animation id="mecha_dragon_ship.interior.blood_off" x="7" count="6" />
  <animation id="mecha_dragon_ship.interior.bg_on" x="13" count="1" length="6"/>
  <animation id="mecha_dragon_ship.interior.blood_on" x="14" count="6" />

  <animation id="mecha_dragon_ship.interior.on" x="0" count="6">
    <append tile="mecha_dragon_ship.interior" animation="mecha_dragon_ship.interior.bg_on" />
    <append tile="mecha_dragon_ship.interior" animation="mecha_dragon_ship.interior.blood_on" />
  </animation>
  <animation id="mecha_dragon_ship.interior.off" x="0" count="6">
