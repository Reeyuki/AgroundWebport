  <vehicle id="mecha_dragon_ship" tile="mecha_dragon_ship" fuel="2000" useBatteries="false" efficiency="0" health="2000" defense="8" speed="14" speedY="7" type="spaceship" attack_move="true" blood="magic.explosion.med" underground="false" flight_height="999" max_weight="8000" death_sfx="dragon_death" title="itemName('world.mecha_dragon_ship', this.name)" includeName="true" block_icon="dragon_ship.shields.ico" block_behind="true" block_move="true" allowModifier="true" tilesBehind="true" fuelName="power">
    <repair id="blood_gem" value="250" /><repair id="titanium" value="250" />
    <interior area="mecha_dragon_ship.interior" offsetX="-8" offsetY="0" enterX="6" enterY="6" exitX="7" operateX="6" operateY="1" />
    <player x="112" y="26" animation="idle"/><operateHitbox x="72" y="64" width="64" height="48" />
    <dismount><action>if(this.renderer != null) this.renderer.scaleX = 1;</action></dismount>
    <slot id="attack" />
    <slot id="subsystem" none="vehicle.evolve" flag="shieldbreaker">
      <window type="recipes" recipes="mecha_dragon_ship" none="common.remove" includeStorehouse="true" title="equipment.subsystem" enabled="var e = this.getEquipment().getItem('subsystem'); return recipe == null || e == null || e.info != recipe.creates.item;">
        <action>this.getEquipment().forceEquip("subsystem", this, recipe == null?null:recipe.creates.asItem())</action>
      </window><stop/>
    </slot>
    <init><set id="partial" value="0" /><set id="cores" value="0" /></init>
    <onFrame>
      var f2 = frames*2; var of = Math.floor(f2); partial += f2-of; if(partial >= 1){of++; partial -= 1;}
      var p = of*cores; if(this.blocking) p -= of*4; if(p > 0) this.addFuel(p); else if(p &lt; 0) this.useFuel(-p);
    </onFrame>
    <mount><set id="cores" value="getPowerCores(this.interior)" /></mount>
    <exitInterior><run object="mecha_dragon_ship" event="mount" /></exitInterior>
    <shield tile="mecha_dragon_ship.shields" animation="mecha_dragon_ship.shields" hit_front="dragon_ship.shields.front" hit_back="dragon_ship.shields.back" hit_sfx="ship_shield" />
    <light tile="light.largest" offsetX="-32" />
    <onDeath><run procedure="mecha_dragon_ship.death" /></onDeath>
    <onTranslate><run procedure="mecha_dragon_ship.talk" /></onTranslate>
  </vehicle>

