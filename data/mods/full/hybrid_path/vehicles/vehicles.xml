  <recipe id="research_mecha_dragon_ship_cannon" creates="mecha_dragon_ship.cannon" title="common.research_item{item:>>item.names>mecha_dragon_ship.cannon}" type="research" fuel_cost="1000" available="player.questComplete('mecha_dragon_ship') && !player.state.hasRecipe('magic_forge', getRecipe('mecha_dragon_ship.cannon'))">
