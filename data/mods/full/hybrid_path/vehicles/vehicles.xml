    <vehicle id="mecha_dragon" type="flying" efficiency="0.5" underground="false" fps="20" fuel="5000" title="itemName('mecha_dragon', this.name)" includeName="true" bgm="voyage" health="500" defense="7" tile="mecha_dragon" speed="8" speedY="6" flight_height="36" max_weight="1500" tooltip="structure.tooltip.fly_dragon" icon="mecha_dragon.ico" death_sfx="dragon_death" hoverWalk="true" allowModifier="true" landOnWater="true" explodeCliff="false" waterLine="52" tilesBehind="true" attack_move="true" hitAnim="true">
