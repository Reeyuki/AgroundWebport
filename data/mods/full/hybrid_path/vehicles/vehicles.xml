  </animation>

  <structure id="mecha_dragon_ship.interior" tile="mecha_dragon_ship.interior" priority="-2" behind="true" remove="false" back="true" powered="true"/>
  <structure id="mecha_dragon_ship.cargo" extends="dragon_ship.cargo1" width="56" height="32" />
  <structure id="mecha_dragon_ship.heart" extends="dragon_ship.heart" width="48" height="48" />
  <structure id="mecha_dragon_ship.save" extends="dragon_ship.save" width="32" height="24" />

  <structure id="mecha_dragon_ship.operate" width="48" height="32" name="operate" fullHeight="true">
    <operate>
      <section if="player.hasItem('translation_book') && (!player.hasSeenItem('dragon_seed') || !player.state.hasRecipe('magic_forge', getRecipe('mecha_dragon_ship.gun')))">
        <menu section="common" closeable="true" autoselect="true">
          <dialogue section="player" id="use_translation_book" />
          <choice id="yes">
            <action>player.inventory.selectItem(getItem('translation_book'),0,null).use(player)</action><stop />
          </choice>
          <choice id="no" />
        </menu>
      </section>
      <section if="getPowerCores(area) > 0"><section if="area.vehicle.canMount(player)">
        <action with="ellipse_fast">var v = area.vehicle; if(v.canMount(player)){v.doExit(player); setGameScale(2); v.doMount(player, true);}</action></section><stop />
      </section><dialogue section="vehicle" id="no_power_cores" />
      <quest id="power_core" if="!player.hasQuest('power_core') && player.info.id != 'player.colosseum'" />
    </operate>
  </structure>

  <area id="mecha_dragon_ship.interior" name="mecha_dragon_ship" shouldLight="false" powered="getPowerCores(this) > 0">
    <action>
      for(x in 1...10){setTile(x,0,"empty"); setTile(x,7,"empty");}
      for(y in 0...8){setTile(0,y,"empty"); setTile(10,y,"empty");}
      setTile(9,1,"empty"); setTile(9,2,"empty"); setTile(1,6,"empty");
      area.floodFill(2, 2, BACK_LAYER, area.addTileIndex("empty"));
    </action>
    <structure id="mecha_dragon_ship.interior" x="0" y="7" />
    <structure id="mecha_dragon_ship.cargo" x="2" y="7" />
    <structure id="mecha_dragon_ship.heart" x="2" y="3" />
    <structure id="mecha_dragon_ship.operate" x="5" y="2" />
    <structure id="mecha_dragon_ship.save" x="5" y="4" />
    <object id="power_core.slot" x="8" y="3" />
    <object id="power_core.slot" x="9" y="4" />
    <object id="power_core.slot" x="8" y="5" />
    <object id="ship.exit" x="6" y="6" />
    <object id="ship.exit" x="1" y="6" />
	<structure id="mecha_dragon_ship.power" x="7" y="5" />
    <init><runAreaLoad /></init>
    <onLoad>
      <music id="dragon_ship" seconds="1" />
      <complete quest="mecha_dragon_ship" useResources="false" if="player.hasQuest('mecha_dragon_ship')" />
    </onLoad>
  </area>

  <procedure id="mecha_dragon_ship.death">
    <choose>
      <equip id="mecha_dragon_backpack" fromInventory="false" name="this.name==null?'':this.name" if="player.equipment.canChangeSlot('back')" />
      <item id="mecha_dragon_backpack" name="this.name==null?'':this.name" />
    </choose>
    <object id="lifepod" x="this.getCenterX()/Tile.SIZE" y="this.yTile/Tile.SIZE" />
    <action>
      this.doDismount(true); lifepod.setFuel(lifepod.getMaxFuel());
      lifepod.inventory.copyFrom(this.inventory); this.inventory.clear(); lifepod.mount(player);
      lifepod.inventory.addItems(Item.get("bandage"), 6);
      lifepod.inventory.addItems(Item.get("battery"), 1);
    </action>
  </procedure>

  <procedure id="mecha_dragon_ship.talk"><choose>
    <section if="!player.hasSeenItem('dragon_seed')">
      <section if="area.id == 'mecha_dragon_ship.interior'">
        <dialogue section="dragon_ship" id="ally1" />
        <dialogue section="dragon_ship" id="ally2" speaker="player" />
      </section>
      <dialogue section="dragon_ship" id="ally3" />
      <choose>
        <dialogue section="dragon_ship" id="ally4.1" speaker="player" if="getFlag('final_boss_defeat')" />
        <dialogue section="dragon_ship" id="ally4" speaker="player" />
      </choose>
      <dialogue section="dragon_ship" id="ally5" />
      <dialogue section="hybrid" id="ally6" />
      <dialogue section="dragon_ship" id="ally7" />
      <choose>
        <section if="!player.questComplete('spirit_portal')">
          <dialogue section="dragon_ship" id="ally8" speaker="player" />
          <dialogue section="dragon_ship" id="ally9" />
          <item id="dragon_seed" />
        </section>
        <action>player.setSeenItem('dragon_seed')</action>
      </choose>
    </section>
    <section if="!player.state.hasRecipe('magic_forge', getRecipe('mecha_dragon_ship.gun'))">
      <dialogue section="hybrid" id="dragon_weps1" />
      <dialogue section="hybrid" id="dragon_weps2" />
      <action>player.state.addRecipe('magic_forge', getRecipe('mecha_dragon_ship.gun')); player.state.addRecipe('magic_forge', getRecipe('mecha_dragon_ship.cannon'));</action>
      <dialogue section="hybrid" id="dragon_weps3" />
    </section>
    <group>
      <dialogue section="hybrid" id="ally10" />
      <dialogue section="dragon_ship" id="ally7" />
      <dialogue section="dragon_ship" id="ally12" />
    </group>
  </choose></procedure>

