  <item id="mecha_dragon" type="animal" cost="0" weight="120" icon="mecha_dragon.ico" durability="5000" canModify="true">
    <action id="plant" name="vehicle.deploy" object="mecha_dragon" onGrass="false" overlapBlueprints="true" overlapStructures="true" removeBushes="false">
      <action>
        object.setFuel(this.getFeed()); object.name = this.getNameStr(); f = Item.getParameter(this.getNameStr(), "f"); if(f != null) object.setHealth(Std.parseInt(f));
      </action>
    </action>
    <action id="rename" />
  </item>

