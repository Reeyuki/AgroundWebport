      <attack type="breath" damage="6" range="12" repeat="2" animation="hover_fire" sfx="dragon_atk" cost="5" element="fire">
        <projectile tile="fire" glow="true" speed="2" frames="8" breakTile="3" breakPower="4" scaleTo="3" offsetX="-67" offsetY="-20" hitEffect="fire_med" hitTrees="true" color="44ffff" colorScale="2">
