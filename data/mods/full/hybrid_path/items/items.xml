    <item id="earth_book" count="1"/>
    <item id="earth_gem" count="1" />
  </recipe>
  <recipe id="make_ice_exo_sword" creates="ice_exo_sword" type="enchantments">
    <item id="exo_sword" count="1" />
    <item id="exotic_gas" count="1" />
    <item id="ice_book" count="1"/>
