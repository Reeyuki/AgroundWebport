		<item id="exotic_gas" count="1" />
		<item id="dragonblood" count="4" />
	</recipe>

  <recipe id="research_focus_gem" creates="focus_gem" type="research" fuel_cost="100" incomplete="blueprint_paper" available="area.getObject('alchemist') != null"/>
  <recipe id="research_alter_gem" creates="alter_gem" type="research" fuel_cost="250" incomplete="blueprint_paper" available="area.getObject('alchemist') != null"/>
  <recipe id="research_blood_gem" creates="blood_gem" type="research" fuel_cost="250" incomplete="blueprint_paper" available="area.getObject('alchemist') != null"/>
		<recipe id="research_evo_shard" creates="evo_shard" type="research" fuel_cost="500" incomplete="blueprint_paper" available="area.getObject('alchemist') != null"/>
  <recipe id="research_spirit_gem" creates="spirit_gem" type="research" fuel_cost="1000" incomplete="blueprint_paper" available="area.getObject('alchemist') != null"/>
		
