		<item id="exo_sword" count="1" />
		<item id="exotic_gas" count="1" />
    <item id="plant_book" count="1"/>
    <item id="plant_gem" count="1" />
	</recipe>
  <recipe id="make_earth_exo_sword" creates="earth_exo_sword" type="enchantments">
    <item id="exo_sword" count="1" />
