	<tile id="cyborg_visor" sheet="sheet.png" x="65" offsetX="-1" />
	<animation id="equipment.cyborg_visor.idle" x="8" count="8" />
	<animation id="equipment.cyborg_visor.hit" x="24" count="6" offsetX="3" offsetY="2" />
	<animation id="cyborg_visor.fire" x="16" count="8" />
	<animation id="equipment.cyborg_visor.fire" x="30" count="8" offsetX="2" offsetY="2">
		<append tile="cyborg_visor" animation="cyborg_visor.fire" />
	</animation>
	<animation id="cyborg_visor.bolt" x="4" count="4" offsetX="12" />
	<animation id="cyborg_visor.bolt.impact" x="0" count="4" offsetX="12" />
	<action>
		function getEnemyInRange(o, range, attack, cut, spirit){
			function filterDefense(o){return o.info.xml.nodeName() == "enemy" &amp;&amp; o.attackPower(attack, cut, spirit, null, false) > 0 &amp;&amp; o.getDefense(false, false, false) &lt; attack &amp;&amp; o.isHostile();}
			var b = o.getClosest(range*Tile.SIZE, 1, true, filterDefense); return b == null?null:b.object;
		}
	</action>
	<item id="cyborg_visor" type="none" slot="head" cost="0" weight="0" attack="12" power="25" range="10" underwater="true" icon="cyborg_visor.ico" unequip="false" enableAttack="true" desc="item.descriptions.auto_fire">
		<action id="use" name="common.remove" closeWindow="false"><run procedure="remove_cyborg" /></action>
		<equipCost storage="power" cost="1" />
		<light tile="light.strong" color="ff9898" flicker="true" /><identify tile="cyborg.identify" acquire="cyborg.acquire" animation="cyborg.identify" color="f61414" />
		<handleSecond><section if="(player.equipment.getStateI('head')&NO_ATTACK) == 0 && getEnemyInRange(player, this.info.range+player.stats.getInt('range'), this.info.attack, this.info.cut, this.info.spirit) != null && player.getPower() >= this.info.storageCost">
			<action>player.renderer.setItemAnimation("head", "fire", false); player.losePower(this.info.storageCost);</action>
			<invokeLater seconds="0.4"><projectile tile="cyborg_visor" animation="cyborg_visor.bolt" speed="5" dx="player.getDX()" spawner="player" damage="this.info.attack" range="this.info.range+player.stats.getInt('range')" width="24" fire_sfx="laser" underwater="true" if="player != null && player.area != null">
				<hitEffect tile="cyborg_visor" animation="cyborg_visor.bolt.impact" color="ff9999" />
			</projectile></invokeLater>
		</section></handleSecond>
	</item>
	
	<recipe id="cyborg_visor" creates="cyborg_visor" type="operation_table" available="player.questComplete('cyborg2')">
