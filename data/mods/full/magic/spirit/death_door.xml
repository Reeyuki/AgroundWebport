		<tiles id="magic1.dirt" start="0" end="0.5" />
		<tiles id="magic1.stone" start="0.5" end="1" />
		<tiles id="magic1.grass" y="0" />
		<action>
			for(y in -6...0) setBack(0, y, "spirit_ladder");
			var x = randInt(3,6); while(x &lt; 61){setOre(x, -randInt(2, 5), "markings1"); x += randInt(6,10);}
			for(x in 1...64){setTile(x, 32, "empty"); setTile(x, 32, "invisible_block");}
		</action>
		<ore id="quartz" start="0.4" end="0.5" percent="0.0025" tile="magic1.dirt" />
		<ore id="alter_gem" start="0.2" end="0.5" percent="0.0125" tile="magic1.dirt" />
		<ore id="focus_gem" start="0.2" end="0.5" percent="0.0175" tile="magic1.dirt" />
		<ore id="evo_shard" start="0.9" end="1.0" percent="0.0025" tile="magic1.stone" />
		<ore id="spirit_gem" start="0.5" end="1.0" percent="0.0125" tile="magic1.stone" />
		<ore id="blood_gem" start="0.5" end="0.9" percent="0.0175" tile="magic1.stone" />
		<objects id="purple_tree" y="-1" startX="4" endX="60" minDist="8" maxDist="10" array="trees" />
		<objects id="magic_wyrm" start="0.6" end="0.9" percent="0.001" tile="magic1.stone" />
		<objects id="purple_golem" start="0.5" end="1.0" percent="0.0075" tile="magic1.stone" />
		<objects id="ice_bush" y="-1" between="trees" pos="0.25" altPos="0.75" percent="0.5" />
		<object id="spirit_lava" x="0" y="32" />
		<spawner id="crawler2" time="4000" count="5" fromX="3" toX="63" fromY="-1" toY="-1" />
		<spawner id="fire_boar" time="4000" count="3" fromX="3" toX="63" fromY="-1" toY="-1" />
		<spawner id="magic_wyrm" time="4000" count="2" fromX="1" toX="62" fromY="8" toY="63" tile="magic1.stone" />
		<spawner id="plant_elemental2" time="5000" count="2" fromX="1" toX="62" fromY="-1" toY="-1" />
		<spawner id="venatrix" time="5000" count="1" fromX="1" toX="62" fromY="-1" toY="-1" />
		<init>
			<action>area.spawner.spawnAll("crawler2"); area.spawner.spawnAll("fire_boar"); area.spawner.spawnAll("plant_elemental2"); area.spawner.spawnAll("venatrix");</action>
			<object id="alchemist.ghost" x="34" y="offsetY-1" if="player.getNPC('alchemist') == null" />
		</init>
	</area>
	<enemy id="magnewyrm2" extends="magnewyrm" eatTile="concrete" captureId="magnewyrm" />
	<npc id="professor.ghost" extends="professor" clearAlpha="false">
		<operate><dialogue section="professor" id="cheater" speaker="this" /></operate>
		<init><lerp object="this" seconds="0.75"><from alpha="0.25" /><to alpha="0.75" /></lerp></init>
	</npc>
	<area id="death_door.ice" width="64" height="32" yStrength="0">
		<tiles id="ice_wall" start="0" end="0.5" />
		<tiles id="concrete" start="0.5" end="1" />
		<tiles id="snow" y="0" />
		<action>
			for(y in -6...0) setBack(0, y, "spirit_ladder");
			var x = randInt(3,6); while(x &lt; 61){setOre(x, -randInt(2, 5), "sand"); x += randInt(6,10);}
			for(x in 1...64){setTile(x, 32, "empty"); setTile(x, 32, "invisible_block");}
			setBack(0, 31, "concrete");
		</action>
		<ore id="exotic_matter" start="0.0" end="0.5" percent="0.0075" tile="ice_wall" />
		<ore id="moissanite" start="0.9" end="1.0" percent="0.0025" tile="concrete" />
		<ore id="chromium" start="0.5" end="1.0" percent="0.0125" tile="concrete" />
		<ore id="magnegem" start="0.5" end="0.9" percent="0.0175" tile="concrete" />
		<objects id="conifer_snow" y="-1" startX="4" endX="60" minDist="8" maxDist="10" array="trees" />
		<objects id="icer" start="0.0" end="0.5" percent="0.0075" tile="ice_wall" />
		<objects id="bush_snow" y="-1" between="trees" pos="0.25" altPos="0.75" percent="0.5" />
		<objects id="magnewyrm2" start="0.6" end="0.9" percent="0.001" tile="concrete" />
		<object id="spirit_lava" x="0" y="32" />
		<spawner id="giantgrub" time="4000" count="2" fromX="3" toX="63" fromY="-1" toY="-1" />
		<spawner id="yeti" time="4000" count="3" fromX="3" toX="63" fromY="-1" toY="-1" />
		<spawner id="magnewyrm2" time="4000" count="2" fromX="1" toX="62" fromY="8" toY="63" tile="concrete" />
		<spawner id="ice_elemental" time="5000" count="2" fromX="1" toX="62" fromY="-1" toY="-1" />
		<spawner id="spirit_imp" time="5000" count="1" fromX="1" toX="62" fromY="-1" toY="-1" />
		<init>
			<action>area.spawner.spawnAll("giantgrub"); area.spawner.spawnAll("yeti"); area.spawner.spawnAll("ice_elemental"); area.spawner.spawnAll("spirit_imp");</action>
			<object id="professor.ghost" x="17" y="offsetY-1" if="player.hasQuest('research_lab') && player.getNPC('professor') == null" />
		</init>
		<onLoad>
			<repeat count="8">
				<tile id="mountain_snow" tile_x="random()*8" x="offsetX+2+random()*28" y="offsetY-2" back="true" />
			</repeat>
		</onLoad>
	</area>
	<animation id="spirit_death.weap" x="16" count="8" />
	<animation id="spirit_death.idle" x="24" count="8">
		<append tile="spirit_guide" animation="spirit_death.weap" behind="true" />
	</animation>
	<animation id="spirit_death.walk" equals="spirit_death.idle" />
	<animation id="spirit_death.weap.pre_attack" x="0" count="1" />
	<animation id="spirit_death.pre_attack" x="24" count="1">
		<append tile="spirit_guide" animation="spirit_death.weap.pre_attack" behind="true" />
	</animation>
	<animation id="spirit_death.weap.attack" x="1" count="7" />
	<animation id="spirit_death.attack" x="25" count="7">
		<append tile="spirit_guide" animation="spirit_death.weap.attack" behind="true" />
	</animation>
	<tile id="death_scythe" equals="spirit_scythe" />
	<item id="death_scythe" type="equipment" equip_anim="equipment.spirit_scythe" melee_range="1" cost="0" slot="weapon" action="equip" weight="0" icon="spirit_scythe.ico" attack="20" cut="20" spirit="20" stamina="0" movement_walk="walk_rswing" knockback="10" underwater="true" sounds="sword" color="000000" hpSteal="-0.25" sfx="spirit_scythe" />
	<enemy id="spirit_death" extends="generic.spirit" tile="spirit_guide" health="100" range="12" animation="spirit_death" color="000000" type="surface" capture="100" spirit_power="100">
		<capture trapped="death_scythe" minCapture="3" />
		<attack type="melee" range="1" damage="50" ignoreArmor="true"><pre><play object="this" animation="pre_attack" /></pre></attack>
	</enemy>
	<area id="death_door.bottom">
		<action>
			for(y in -4...0) setBack(0, y, "spirit_ladder");
			for(x in -8...9){setTile(x, 0, "empty"); setTile(x, 0, "invisible_block");}
		</action>
		<object id="spirit_death" x="3" />
	</area>
</data>