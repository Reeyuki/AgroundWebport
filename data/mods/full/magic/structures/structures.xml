	<action>
		function isModVehicle(object, layer){
			return object.info.xml.get("allowModifier") == "true";
		}
		function getModVehicleInStructure(factory){
			return factory.area.getActionObject(factory.getInnerBounds(true), null, isModVehicle);
		}
	</action>
	<procedure id="vehicle.modify">
		<set id="v" value="getModVehicleInStructure(this)" /><set id="mod" value="Item.getModItem(v.name)" />
		<window type="items" titleMutable="v.getTitle(player)" includeStorehouse="true" filter="function(i){return Item.hasModifiers(i);}" enabled="function(i){return mod != i;}" additionalInfo="function(item, s, w, x, y){return Item.halfScale(Item.addModifierInfo, item, s, w, x, y);}">
			<action>if(mod != item &amp;&amp; inventory.addItems(item, -1, value, name)) v.name = Item.setParameter(v.name, "m", item.id);</action>
		</window>
	</procedure>
