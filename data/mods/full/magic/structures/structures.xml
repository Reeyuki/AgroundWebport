	<animation id="drag_factory.idle" x="9" count="1" />
    <animation id="drag_factory.snow" x="0" count="9" length="2" />
    <animation id="drag_factory.hidden"><frame visible="false" length="1" /></animation>
	<structure id="drag_factory" tile="drag_factory" name="evolve" type="crafting" title="structure.tooltip.evolve" only_select="true">
		<listItem icon="dragon_ship.ico" title="structure.tooltip.evolve_dragon" fail="this.getObjectInBounds('fly_ancient_dragon') != null?'warning.ingredients':'warning.no_item{item:[object=fly_ancient_dragon]}'">
			<tooltip type="requires" requires="quests.requires">
				<option>
					<value icon="ancient_dragon.ico" title="vehicle.ancient_dragon" if="this.getObjectInBounds('fly_ancient_dragon') != null" />
					<value icon="ancient_dragon.ico" title="structure.place_in_lair{item:[object=fly_ancient_dragon]}" error="true" />
				</option>
				<requirement icon="evo_gem.ico" title="item.names.evo_gem" count="player.getItemCountStorehouse('evo_gem')" of="1" />
				<requirement icon="dragonblood.ico" title="item.names.dragonblood" count="player.getItemCountStorehouse('dragonblood')" of="20" />
				<requirement icon="blood_gem.ico" title="item.names.blood_gem" count="player.getItemCountStorehouse('blood_gem')" of="20" />
				<requirement icon="focus_gem.ico" title="item.names.focus_gem" count="player.getItemCountStorehouse('focus_gem')" of="20" />
			</tooltip>
			<section if="this.getObjectInBounds('dragon_ship') != null"><dialogue section="warning" id="drag_ship_factory" /><stop /></section>
			<closeWindows />
            <item id="evo_gem" count="-1" storehouse="true" />
            <item id="dragonblood" count="-20" storehouse="true" />
            <item id="blood_gem" count="-20" storehouse="true" />
            <item id="focus_gem" count="-20" storehouse="true" />
            <section with="fade">
				<action>oldScale = getGameScale(); setGameScale(2)</action><pan x="256-this.xPos-this.info.width*0.5" y="256-this.yPos" seconds="0" />
				<play object="this" animation="hidden" loop="true" />
				<set id="dragon" value="this.getObjectInBounds('fly_ancient_dragon')" />
				<action>dragon.alpha = 0;</action><remove object="dragon" />
				<addAnimation to="this" modal="true">
					<add fps="10" id="bg" tile="drag_factory_bg" animation="single" />
					<add fps="10" id="first" tile="ancient_dragon" animation="ancient_dragon.idle" offsetX="-0.5" offsetY="-1" x="224" y="256" />
					<add fps="10" id="second" tile="dragon_ship" animation="dragon_ship.idle" offsetX="-0.5" offsetY="-1" x="272" y="256" alpha="0" />
					<add fps="10" id="fg" tile="drag_factory_fg" animation="single" />
					<wait seconds="1" />
					<play id="bg" animation="drag_factory_fx" />
					<play id="fg" animation="drag_factory_fx" modal="true" />
					<play id="bg" animation="drag_factory_fx_loop" loop="true" />
					<play id="fg" animation="drag_factory_fx_loop" loop="true" />
					<lerp id="first" alpha="0" seconds="0.5" />
					<lerp id="second" alpha="1" seconds="0.5" modal="true" />
					<wait seconds="1" />
					<action>this.runAnimation("single", null)</action>
					<lerp id="bg" alpha="0" seconds="1" />
					<lerp id="fg" alpha="0" seconds="1" modal="true" />
				</addAnimation>
				<object id="dragon_ship" x="(this.xPos+160)/Tile.SIZE" y="this.yPos/Tile.SIZE-4" />
				<action>dragon_ship.name = dragon.name; dragon_ship.inventory.copyFrom(dragon.inventory); dragon_ship.setFuel(Math.round(dragon.getFuelPercent()*dragon_ship.getMaxFuel()));</action>
				<play object="this" animation="snow" modal="true" /><action>player.checkQuestComplete(null);</action>
            </section>
            <section with="fade"><action>setGameScale(oldScale)</action><pan toObject="player" seconds="0" /></section>
		</listItem>
		<operate>
			<section if="!player.hasQuest('dragon_ship')"><dialogue section="structure" id="drag_factory_ruins" /><stop /></section>
			<section if="area.getObject('ice_boss') != null"><dialogue section="structure" id="too_cold" /><stop /></section>
		</operate>
