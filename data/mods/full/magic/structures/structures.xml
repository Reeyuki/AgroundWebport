			<choose if="!getFlag('final_boss_defeat')">
				<scene id="alchemist" show="east_dead" with="fade" if="area.getNPC('alchemist_magic') == null" showToAll="true" />
				<scene id="alchemist" show="east" with="fade" showToAll="true" />
			</choose><action>player.restoreStamina();</action><save sleep="true" /><stop />
			</section>
		</operate>
	</structure>
	
