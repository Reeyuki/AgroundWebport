					<action>player.loseStamina(this.getStamina(player)); if(player.area != null) area.setWaterBlock(player.tile_x, player.tile_y);</action>
				</choose>
				<wait seconds="0.3" modal="false" />
			</section>
			<dialogue section="warning" id="no_use" />
		</choose></action>
	</item>
	
