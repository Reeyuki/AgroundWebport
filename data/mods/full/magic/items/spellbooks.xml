	<procedure id="player.teleport_out">
		<sound id="teleport_book" /><action>player.renderer.useItem(this)</action>
		<wait seconds="0.3" modal="false" />
		<hitEffect object="player" tile="alchemist" animation="alchemist.teleport" runPaused="true" />
		<lerp object="player" alpha="0" seconds="0.5" modal="true" />
	</procedure>
	<procedure id="player.teleport_in">
		<action>player.renderer.alpha = 0;</action>
		<hitEffect object="player" tile="alchemist" animation="alchemist.teleport" runPaused="true" />
		<lerp object="player" alpha="1" seconds="0.5" modal="true" />
	</procedure>
	<object id="teleport.beacon" tile="alchemist" animation="alchemist.teleport_cycle" alpha="0.5" action="common.remove" layer="npc">
		<operate><remove object="this" /></operate>
	</object>
	<item id="teleport_book" type="spellbook" behindPlayer="false" equip_anim="equipment.magic_book" cost="6000" stamina="100" weight="2" icon="spellbook.ico" master_spellcaster="true" animation="magic_book.ico" use_stamina="true" staminaStat="spellcast" underwater="true" canModify="false">
		<use slot="shield" /><action id="use" name="cast">
			<stop if="player.renderer.equipComplete != null" />
			<set id="sleep" value="player.findClosestStructure(Area.isSleep)" />
			<set id="exit" value="area.getExit()" />
			<set id="beacon" value="player.getNPC('teleport.beacon')" /><choose>
			<dialogue section="warning" id="no_use_vehicle" if="player.vehicle != null" />
			<dialogue section="warning" id="teleport_blocked" if="area.getCustomFlag('blockTeleport')" />
			<section if="player.inDungeon()">
				<action>player.loseStamina(this.getStamina(player))</action><stop if="player.area == null" /><run procedure="player.teleport_out" /><section with="fade"><return /><run procedure="player.teleport_in" /></section>
			</section>
			<section if="exit != null">
				<action>player.loseStamina(this.getStamina(player))</action><stop if="player.area == null" /><run procedure="player.teleport_out" /><section with="fade"><teleport area="exit.area" x="exit.x" y="exit.y" /><run procedure="player.teleport_in" /></section>
			</section>
			<section if="beacon != null && beacon.area != null">
				<action>player.loseStamina(this.getStamina(player))</action><stop if="player.area == null" /><run procedure="player.teleport_out" /><section with="fade"><action>player.doTeleport(null, beacon.xPos, beacon.yTile, false, beacon.area);</action><run procedure="player.teleport_in" /></section>
			</section>
			<section if="sleep != null">
				<action>player.loseStamina(this.getStamina(player))</action><stop if="player.area == null" /><run procedure="player.teleport_out" /><section with="fade"><move object="player" structure="sleep" /><run procedure="player.teleport_in" /></section>
			</section>
			<dialogue section="warning" id="teleport_fail" />
		</choose></action>
	</item>
	
	<item id="water_barrier_book" type="spellbook" behindPlayer="false" equip_anim="equipment.water_book" cost="6000" stamina="100" weight="2" icon="spellbook.ico" master_spellcaster="true" animation="water_book.ico" use_stamina="true" staminaStat="spellcast" underwater="true" element="water" canModify="false">
