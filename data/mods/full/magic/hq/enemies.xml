		<lootSet><loot id="alien_heart" /></lootSet>
		<lootSet><loot id="exotic_matter" count="3" /></lootSet>
		<tile id="final_boss.stage2" animation="final_boss.stage2.legs" fps="10" y="0" offsetX="-0.5" offsetY="-0.5" />
		<tile id="final_boss.stage2" name="fx" animation="hidden" fps="10" y="0" />
		<tile id="final_boss.stage2" name="cast" animation="hidden" fps="10" y="0" />
		<init><set id="hpps" value="Math.round(this.getMaxHealth()/10)" /><action>
			elements = [getElement("fire"), getElement("water"), getElement("ice"), getElement("earth"), getElement("plant")]; this.changeTint(0x7e13cb, 1.5); hp = this.getMaxHealth();
			colors = [0xff3333, 0x3333ff, 0x33ffff, 0xffcc33, 0x33ff33]; fx = ["final_boss.stage2.fire", "hidden", "final_boss.stage2.ice", "final_boss.stage2.earth", "hidden"]; current = 0;
			if(hp > this.getHealth()){
				var ct = Math.ceil((hp-this.getHealth())/hpps); hp -= ct*hpps; current = (ct-1)%elements.length; this.element = elements[current]; this.changeTint(colors[current], 1.5);
				var tile = this.getTileById("fx"); if(tile != null) tile.playAnimation(fx[current], true, null, -0.5, -0.5); current++; if(current >= elements.length) current = 0;
			}
		</action></init>
		<onDeath>
			<action if="exists('orbs')">while(orbs.length > 0) area.removeObject(orbs.pop());</action>
			<shake count="10" dx="2" seconds="2" />
			<scene id="aliens" show="final_boss3" with="fade" showToAll="true">
				<remove objectsById="fire_bird_end" />
				<remove objectsById="snaptopus_end" />
				<remove objectsById="crawler_end" />
				<remove objectsById="golem_end" />
				<remove objectsById="icer_end" />
			</scene>
			<invokeLater seconds="1">
				<section if="player.questComplete('launch_virus') && area.getObject('nursery.crab') != null">
					<call id="president" incoming="true" />
					<call id="president" end="true" />
					<scene id="colony" show="boss_defeat" with="fade" showToAll="true" />
				</section>
			</invokeLater>
		</onDeath>
		<loseHealth><action if="var c = this.getTileById('cast'); return hp > this.getHealth() && (c == null || c.animation == 'hidden')">
			this.element = elements[current]; this.changeTint(colors[current], 1.5, 15); hp -= hpps;
			var tile = this.getTileById("fx"); if(tile != null) tile.playAnimation(fx[current], true, null, -0.5, -0.5); current++; if(current >= elements.length) current = 0;
			if(hp &lt; hpps*5 &amp;&amp; area.isActivePlayer()){
				var id = null; if(this.element.id == 'fire') id = "fire_bird_end";
				else if(this.element.id == 'water') id = "snaptopus_end";
				else if(this.element.id == 'plant') id = "crawler_end";
				else if(this.element.id == 'earth') id = "golem_end";
				else if(this.element.id == 'ice') id = "icer_end";
				var o = getObject(id); if(o != null){
					function addObject(o){area.addObject(o); if(o.renderer != null){o.renderer.alpha = 0; o.renderer.lerp(new AlphaKeyframe(1), 10);}}
					addObject(o.create(Math.round((this.xPos-32)/Tile.SIZE)*Tile.SIZE, this.tile_y*Tile.SIZE));
					addObject(o.create(Math.round((this.xPos+this._width+32)/Tile.SIZE)*Tile.SIZE, this.tile_y*Tile.SIZE));
					addObject(o.create(Math.round((this.xPos-32)/Tile.SIZE)*Tile.SIZE, Math.round((this.yTop()+Tile.SIZE)/Tile.SIZE)*Tile.SIZE));
					addObject(o.create(Math.round((this.xPos+this._width+32)/Tile.SIZE)*Tile.SIZE, Math.round((this.yTop()+Tile.SIZE)/Tile.SIZE)*Tile.SIZE));
				}
			}
		</action></loseHealth>
		<cooldown seconds="5">
			<set id="cast" value="this.getTileById('cast')" />
			<stop if="this.element == null || cast == null" />
			<play object="cast" animation="'final_boss.stage2.cast.'+this.element.id" offsetX="-0.5" offsetY="-0.5" />
			<play object="cast" animation="hidden" loop="true" />
			<choose>
				<section if="this.element.id == 'fire'"><action>spawner = this; count = 15; damage = 40;</action><run procedure="spell.meteor.multi" /></section>
				<section if="this.element.id == 'water'"><action>spawner = this;</action><object id="spell.flood" x="(this.getCenterX()-72)/Tile.SIZE" y="(this.getCenterY()+64)/Tile.SIZE" pre="true">this.vars.set("spawner", spawner); this.vars.set("damage", 10);</object></section>
				<section if="this.element.id == 'plant'"><action>spawner = this;</action><object id="spell.growth" x="(this.getCenterX()-72)/Tile.SIZE" y="(this.getCenterY()+64)/Tile.SIZE" pre="true">this.vars.set("spawner", spawner); this.vars.set("damage", 48);</object></section>
				<section if="this.element.id == 'earth'"><action>spawner = this; x = 0; count = 4; side = 1; centerX = spawner.getCenterX(); damage = 50;</action><run procedure="spell.earth.multi" /></section>
				<section if="this.element.id == 'ice'">
					<projectile spawner="this" damage="60" range="18" dx="this.getDX()" tile="spell.tornado" animation="spell.tornado" speed="2" element="ice" homing="true" pierce="true" passTile="true" hitEffect="freeze">
						<spawn><run procedure="spell.tornado.form" /></spawn>
					</projectile>
				</section>
			</choose>
		</cooldown>
		<cooldown seconds="1">
			<set id="orbs" value="orbs.filter(function(o){return o.area != null;})" if="orbs.length > 0" />
			<action if="orbs.length > 0 && orbs[0].alpha >= 1">var p = area.getClosestPlayer(this.getCenterX(), this.getCenterY()); if(p != null) Movement.seek(orbs.shift(), p, 3+random()*3);</action>
		</cooldown>
		<cooldown seconds="10">
			<run procedure="final_boss.orbs" if="!exists('orbs') || orbs.length == 0" />
		</cooldown>
	</enemy>
</data>