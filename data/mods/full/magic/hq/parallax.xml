<?xml version="1.0" encoding="utf-8" ?>
<data>
	<include id="bg.xml" /><tile id="alien_hq.crystals" sheet="bg.2" x="0" /><tile id="alien_hq.nav" sheet="bg.1" x="2" />
	<animation id="alien_hq.crystals">
		<frame visible="false" length="8" /><append tile="alien_hq.crystals" animation="item8" flip="true" />
	</animation>
	<tilesheet id="fg.png" width="1024" height="16" />
	<parallax id="alien_hq" mapBG="544aab" mapBGHeight="80" waterLevel="0">
		<layer p="0" day="true"><rect color="544aab" x="0" y="0" width="256" height="144" /></layer>
		<layer p="0" day="false" storm="false" glow="true"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0"><tile sheet="bg.1" x="1" /></layer>
		<layer p="0.0625" py="0.25"><tile sheet="bg.1" x="0" /></layer>
		<layer p="0.125" py="0.5"><tile sheet="bg.3" x="0" /></layer>
		<layer p="0.1875" py="0.625" glow="true" layerWidth="768" layerHeight="144">
			<tile id="alien_hq.crystals" animation="item8" fps="10" /><tile id="alien_hq.crystals" animation="item8" fps="10" offsetX="768" />
			<tile id="alien_hq.crystals" animation="alien_hq.crystals" fps="10" offsetX="700" />
		</layer>
		<layer p="0.5" py="1"><tile sheet="fg.png" x="0" offsetY="128" /></layer>
		<layer type="back" />
	</parallax>
	<tile id="alien_hq.orbit" sheet="bg.1" x="3" />
	<animation id="alien_hq.orbit.open"><frame x="0" length="4" /><frame x="1" count="9" /></animation>
	<animation id="alien_hq.orbit.close" count="10" reverse="true" />
	<animation id="alien_hq.orbit.cycle" x="10" count="6" />
	<parallax id="alien_hq.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<choose>
			<layer p="0" py="0.0125" max_depth="10000" if="getFlag('alien_hq.open') && !getFlag('alien_hq.locked')" name="hq"><tile id="alien_hq.orbit" animation="alien_hq.orbit.cycle" fps="6" offsetY="22" /></layer>
			<layer p="0" py="0.0125" max_depth="10000" name="hq"><tile id="alien_hq.orbit" animation="single" fps="6" offsetY="22" /></layer>
		</choose>
		<layer type="back" />
	</parallax>
</data>