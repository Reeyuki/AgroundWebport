<?xml version="1.0" encoding="utf-8" ?>
<data>
	<include id="parallax.xml" />
	<include id="enemies.xml" />
	<procedure id="science_endgame">
		<call id="president" incoming="true" /><call id="president" end="true" /><scene id="colony" show="victory" with="fade" showToAll="true" />
	</procedure>
	<planet id="alien_hq" height="42">
		<orbit id="alien_hq.orbit" width="256" height="64" background="alien_hq.orbit" name="system.planet.alien_hq_orbit" type="none" canEnterPlanet="getFlag('alien_hq.open') && !getFlag('alien_hq.locked')" hasEnemy="true">
			<area id="alien_hq" x="0" />
		  <spawner id="alien.fighter" time="4000" count="6" fromX="2" toX="254" fromY="10" toY="54" ground="false" enabled="!getFlag('dragon_sanctuary')"/>
		  <spawner id="npc.alien.fighter" time="10000" count="2" fromX="2" toX="254" fromY="10" toY="54" ground="false" enabled="getFlag('dragon_sanctuary')"/>
			<spawner id="alien.bomber" time="8000" count="2" fromX="2" toX="254" fromY="10" toY="54" ground="false" enabled="!getFlag('final_boss_defeat')" />
			<spawner id="alien.cruiser" time="16000" count="1" fromX="2" toX="254" fromY="10" toY="54" ground="false" enabled="!getFlag('final_boss_defeat')" />
			<init><runAreaLoad /><action>area.spawner.spawnAll('alien.fighter'); area.spawner.spawnAll('alien.bomber'); area.spawner.spawnAll('alien.cruiser');</action></init>
			<onLoad>
				<music id="orbit_combat" seconds="1" /><radar tile="orbit.radar" animation="orbit.radar" padding="2" />
				<section if="getFlag('alien_hq.open') && getFlag('final_boss_defeat') && !getFlag('alien_hq.locked') && (player.vehicle == null || !player.vehicle.isDrone()) && !getFlag('hybrid_win')">
				  <action>
					setFlag('alien_hq.locked', true); getParallaxLayer("hq").getChildAt(0).playAnimation("alien_hq.orbit.close", false, function(p){p.playAnimation("single", true);});
				  </action><invokeLater seconds="2" if="!getFlag('magic_path_end') && !getFlag('hybrid_win')"><run procedure="science_endgame" /></invokeLater>
				</section><stop if="getFlag('final_boss_defeat')" />
				<section if="player.hasQuest('launch_virus') && !getFlag('colony.virus')">
					<scene id="colony" show="virus" with="fade" showToAll="true">
						<action>
							setFlag('colony.virus', true); area.spawner.spawnAll('alien.fighter'); area.spawner.spawnAll('alien.bomber'); area.spawner.spawnAll('alien.cruiser');
						</action>
					</scene>
					<objects id="npc.exo_fighter" width="4" height="4" count="8" fromX="2" toX="254" fromY="10" toY="54" ground="false" />
					<objects id="npc.fighter" width="4" height="4" count="3" fromX="2" toX="254" fromY="10" toY="54" ground="false" />
				</section>
				<section if="!getFlag('colony_world') && player.questComplete('locate_hq')">
					<scene id="scavenger" show="alien_hq" with="fade" if="!getFlag('prof.alien_hq') && player.getNPC('professor').area.getPlanet().id=='alien_hq'" showToAll="true"><action>setFlag('prof.alien_hq', true)</action></scene>
					<invokeLater seconds="20"><run procedure="colony.rescue" if="!getFlag('colony_world') && area.id == 'alien_hq.orbit'" /></invokeLater>
					<event onMount="null" once="true" autorun="false"><run procedure="colony.rescue" if="!getFlag('colony_world') && area.id == 'alien_hq.orbit'" /></event>
				</section>
				<run procedure="checkHQVirus" if="player.canCompleteQuest('launch_virus')" />
			</onLoad>
			<toNav><section if="!getFlag('final_boss_defeat') && !getFlag('colony_world') && player.questComplete('locate_hq')"><run procedure="colony.rescue" /><stop /></section></toNav>
		</orbit>
	</planet>
	<include id="nursery/nursery.xml" />
	<animation id="cells" count="8" length="2" />
	<include id="structures.xml" />
	<enemy id="wyrm_hq" extends="wyrm" eatTile="cells1" />
	<animation id="alien_hq.heart.idle" equals="item8" />
	<tilesheet id="heart.png" width="256" height="160" />
	<tile id="alien_hq.heart" sheet="heart.png" />
	<structure id="alien_hq.heart" tile="alien_hq.heart" behind="true" remove="false" fps="9" />
	<object id="final_boss.hotspot" width="256" height="160" overlapVehicle="true">
		<over><remove object="this" /><scene id="aliens" show="final_boss1" with="fade" showToAll="true" /></over>
	</object>
	<area id="alien_hq.heart" width="256" height="30">
		<tiles id="cells1" start="0" end="1" />
		<spreadTiles x="128" y="15" tile="cells2" on="cells1" layer="back" count="500" />
		<mine start="0" end="1" />
		<tiles id="blackstone.ore" y="29" />
		<ore id="lava" start="0" end="1" percent="1" tile="blackstone.ore" />
		<structure id="alien_hq.heart" x="120" y="20" />
		<object id="final_boss.hotspot" x="120" y="20" />
		<object id="final_boss" x="121.75" y="21.25" />
	</area>
	<area id="alien_hq" width="256" height="56" tile_anim="cells" background="alien_hq" planet="alien_hq" looping="true" name="system.planet.alien_hq" tile_break="blood" viewHidden="true">
		<tiles id="cells1" start="0" end="0.3" />
		<tiles id="cells2" start="0.3" end="0.75" />
		<tiles id="cells3" start="0.75" end="1" />
		<tiles id="cells3" y="55" />
		<appendArea id="alien_hq.nursery" offsetX="20" offsetY="0" />
		<appendArea id="alien_hq.heart" offsetY="56" />
		<ore id="blood_gem" start="0.2" end="0.3" percent="0.00625" tile="cells1" />
		<ore id="alter_gem" start="0.0" end="0.3" percent="0.00625" tile="cells1" />
		<ore id="focus_gem" start="0.0" end="0.2" percent="0.0125" tile="cells1" />
		<ore id="blood_gem" start="0.3" end="0.6" percent="0.00625" tile="cells2" />
		<ore id="spirit_gem" start="0.4" end="0.6" percent="0.0125" tile="cells2" />
		<ore id="evo_shard" start="0.6" end="0.75" count="15" tile="cells2" />
		<ore id="lava" start="0.4" end="0.6" percent="1" tile="cells2" />
		<ore id="magnegem" start="0.75" end="1" percent="0.0125" tile="cells3" />
		<ore id="evo_shard" start="0.75" end="1" count="20" tile="cells3" />
		<ore id="exotic_matter" start="0.75" end="1" count="30" tile="cells3" />
		<structure id="alien_hq.growth" x="60" />
		<structure id="alien_hq.factory" x="120" />
		<structure id="alien_hq.library" x="220" />
		<objects id="wyrm_hq" start="0.1" end="0.3" percent="0.0002" tile="cells1" />
		<spawner id="wyrm_hq" time="4000" count="3" fromX="2" toX="254" fromY="3" toY="16" tile="cells1" />
    <spawner id="dragomech" time="8000" count="2" fromX="2" toX="254" fromY="-20" toY="-1" ground="false" enabled="getFlag('aliens.hostile')"/>
    <spawner id="ancient_dragon" time="8000" count="5" fromX="2" toX="254" fromY="-30" toY="-10" ground="false" enabled="getFlag('aliens.hostile')"/>
		<fishing><loot id="dragonblood" p="4" difficulty="3" /><loot id="alien_heart" p="1" difficulty="6" /></fishing>
		<init><runAreaLoad /><action>area.spawner.spawnAll('dragomech'); area.spawner.spawnAll('ancient_dragon');</action></init>
		<onLoad><music id="alien_hq" seconds="1" /></onLoad>
		<toOrbit>
      <window type="prompt" message="warning.leave_alien_hq" if="getFlag('final_boss_defeat') && !getFlag('hybrid_win') && (player.vehicle == null || !player.vehicle.isDrone())" on="no"><stop /></window>
		</toOrbit>
	</area>
	<animation id="alien_hq.star" count="1" color="ff6666" />
	<system id="alien_hq" bgm="boss" x="180" y="24" available="getFlag('alien_hq')" animation="alien_hq.star">
		<planet id="alien_hq" tile="alien_hq.nav" orbit="orbit3" orbitOffX="-20" orbitOffY="-23" offsetX="13" offsetY="15" name="system.planet.alien_hq" />
	</system>
	
	<include id="npcs.xml" />
	<include id="scenes/scenes.xml" />
</data>