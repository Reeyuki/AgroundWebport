		for(y in (offsetY-4)...offsetY) setBack(offsetX+24, y, "empty");
		for(x in (offsetX+20)...(offsetX+24)) setBack(x, offsetY-2, "empty");
		setBack(offsetX+23, offsetY-7, "empty"); setBack(offsetX+23, offsetY-3, "empty");
		for(x in (offsetX+38)...(offsetX+41)) setBack(x, offsetY-1, "empty");
