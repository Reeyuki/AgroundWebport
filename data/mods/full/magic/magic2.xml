		for(x in (offsetX+45)...(offsetX+47)) setBack(x, offsetY-2, "empty");
		for(x in (offsetX+40)...(offsetX+47)) setBack(x, offsetY-3, "empty");
		for(x in (offsetX+41)...(offsetX+44)) setBack(x, offsetY-6, "empty");
		for(x in (offsetX+43)...(offsetX+46)) setBack(x, offsetY-4, "empty");
