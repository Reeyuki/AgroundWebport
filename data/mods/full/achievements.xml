<data>
	<procedure id="player.addItem" extends="player.addItem">
		<achievement id="hybrid_dragon" if="player.hasSeenItem('mecha_dragon')" />
		<achievement id="enchanted_exo" if="player.hasSeenItem('fire_exo_sword') && player.hasSeenItem('plant_exo_sword') && player.hasSeenItem('water_exo_sword') && player.hasSeenItem('earth_exo_sword') && player.hasSeenItem('ice_exo_sword')" />
		<achievement id="witch" if="player.hasSeenItem('witch_hat') && player.hasSeenItem('robes') && player.hasSeenItem('flying_broom') && player.hasSeenItem('wand') && player.hasSeenItem('black_cat')" />
		<achievement id="exo_set" if="player.hasSeenItem('exo_gun') && player.hasSeenItem('exo_sword') && player.hasSeenItem('exo_drill') && player.hasSeenItem('exo_pack') && player.hasSeenItem('exo_armor')" />
		<action>
			seen_spellbooks = true; for(i in Item.getAll()) if(i.xml.get("master_spellcaster") == "true" &amp;&amp; !player.hasSeenItem(i.id)) seen_spellbooks = false;
		</action>
		<achievement id="master_spellcaster" if="seen_spellbooks" />
	</procedure>
	<procedure id="player.changeEquip" extends="player.changeEquip">
		<achievement id="cyborg2" if="player.hasItem('cyborg_chainsaw') && player.hasItem('cyborg_railgun') && player.hasItem('cyborg_plate') && player.hasItem('cyborg_visor') && player.hasItem('cyborg_core')" />
	</procedure>
