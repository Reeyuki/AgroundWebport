<?xml version="1.0" encoding="utf-8" ?>
<data>
	<include id="parallax/parallax.xml" />
	<area id="science2" width="128" height="32" background="science2" planet="start">
		<shore x="-1" top="sand_top" bottom="sand" trans1="dirt_sand1" trans2="dirt_sand2" flip="true" dock="dock_empty" height="96" />
		<shore x="128" top="sand_top" bottom="sand" trans1="dirt_sand1" trans2="dirt_sand3" dock="dock_empty_flip" height="96" />
		<object id="com_placeholder" x="55" y="-33" />
		<appendArea id="science2.top" offsetX="0" offsetY="-32" />
		<appendArea id="science2.maze" offsetX="16" offsetY="0" />
		<appendArea id="science2.mid" offsetX="0" offsetY="-16" />
		<tiles id="grass" y="0" empty="front|back" />
		<tiles id="dirt" start="0" end="1" empty="front|back" />
		<appendArea id="sea_floor"><params area_left="-240" area_right="280" area_width="128" area_height="96" /></appendArea>
		<ore id="quartz" start="0.8" end="1" percent="0.0025" tile="dirt" />
		<ore id="iron" start="0.2" end="1" percent="0.00625" tile="dirt" />
		<ore id="coal" start="0.0" end="0.8" percent="0.0175" tile="dirt" />
		<ore id="gold" start="0.8" end="1" percent="0.000625" tile="dirt" />
		<objects id="conifer" y="-1" fromX="5" toX="12" count="1" />
		<objects id="conifer" y="-1" fromX="116" toX="123" count="1" />
		<objects id="bush" y="-1" fromX="5" toX="12" percent="0.25" />
		<objects id="red_bush" y="-1" fromX="5" toX="12" percent="0.175"  />
		<objects id="bush" y="-1" fromX="116" toX="123" percent="0.25" />
		<objects id="red_bush" y="-1" fromX="116" toX="123" percent="0.175"  />

		<fishing>
			<loot id="rockfish" p="12" difficulty="2" />
			<loot id="coral_cod" p="1" difficulty="3" />
			<loot id="fin" p="4" difficulty="4" />
			<loot id="pearl" p="1" difficulty="5" achievement="clam_pearl" />
		</fishing>
		<connection area="farming" fromX="-240" toX="280" />
		<connection area="science1" fromX="280" toX="-250" />
		<spawner id="shark" time="5000" count="18" fromX="-100" toX="228" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<spawner id="jellyfish" time="5000" count="25" fromX="-100" toX="228" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<spawner id="flapper" time="5000" count="5" fromX="-100" toX="228" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<spawner id="skyfish" time="2000" count="8" fromX="132" toX="228" fromY="-15" toY="-3" ground="false" />
		<spawner id="snaptopus" time="10000" count="6" fromX="17" toX="62" fromY="3" toY="62" spawnWidth="128" underwater="true" />
		<spawner id="clam" time="5000" count="18" fromX="-100" toX="228" fromY="3" toY="78" spawnWidth="64" underwater="true" bottom="true" />
		<spawner id="metal_debris1" time="5000" count="20" fromX="17" toX="270" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris2" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris3" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris4" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris5" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris6" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris7" width="4" height="2" count="2" fromX="17" toX="62" fromY="3" toY="62" underwater="true" />
		
		<objects structure="life_pod_debris_corpse" width="3" height="8" fromX="140" toX="270" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod2" />
		<objects structure="life_pod_debris3" width="3" height="8" fromX="140" toX="270" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod7" />
		
		<init><runAreaLoad /><action>area.spawner.spawnAll("shark"); area.spawner.spawnAll("skyfish"); area.spawner.spawnAll("snaptopus"); area.spawner.spawnAll("clam");
			area.spawner.spawnAll("jellyfish");  area.spawner.spawnAll("flapper");
			for(i in 1...8) area.spawner.spawnAll("metal_debris"+i);</action></init>
		<onLoad>
			<tile id="seagull" animation="seagull.walk" x="random()*5" />
			<tile id="seagull" animation="seagull.fly" x="-random()*5" y="-2" />
			<tile id="seagull" animation="seagull.fly" x="-random()*5-1" y="-4" />
			<tile id="seagull" animation="seagull.walk" x="127-random()*5" />
			<tile id="seagull" animation="seagull.fly" x="128+random()*5" y="-2" />
			<tile id="seagull" animation="seagull.fly" x="129+random()*5" y="-4" />
			<music id="heights" seconds="1" /><weather type="snow" fromY="-50" toY="-16" />
			<appendArea id="sea_floor" if="area.getObject('seaweed') == null"><params area_left="-240" area_right="280" area_width="128" area_height="96" /></appendArea>
		</onLoad>
	</area>
	<object id="mechanic.hotspot" width="512">
		<over><set id="mechanic" value="player.getNPC('mechanic')" />
		<section if="player.hasQuest('com_station') && !player.questComplete('com_station') && !outsideCallRange(player, mechanic) && mechanic.talking.get() == null">
			<action>lockNPC(mechanic)</action><remove object="this" />
			<call id="mechanic" incoming="true" />
			<choose>
				<run procedure="mechanic.com_station" if="player.canCompleteQuest('com_station')" />
				<dialogue section="mechanic" id="build_com7" speaker="mechanic" />
			</choose>
			<call id="mechanic" end="true" />
		</section></over>
	</object>
	<area id="science2.top">
		<shape type="trapezoid">
			<top y="0" fromX="32" toX="64" />
			<bottom y="16" fromX="24" toX="72" />
		</shape>
		<tiles id="snow" top="0" />
		<tiles id="snow_stone" top="1" />
		<tiles id="ice" start="0.2" end="0.5" empty="true" />
		<tiles id="stone" start="0" end="1" empty="true" />
		<mine start="0.2" end="0.5" tile="ice" />
		
		<ore id="sulfur" start="0.3" end="1.0" percent="0.0125" tile="stone" />
		<ore id="iron" start="0.0" end="0.8" percent="0.0125" tile="stone" />
		<ore id="coal" start="0.0" end="0.8" percent="0.0125" tile="stone" />
		
		<objects id="conifer_snow" y="-1" startX="28" endX="63" minDist="6" maxDist="9" array="trees" />
		<objects id="icer" start="0.2" end="0.5" count="3" tile="ice" />
		<objects id="red_bush_snow" y="-1" between="trees" pos="0.25" altPos="0.75" percent="0.34" />
		<objects id="bush_snow" y="-1" between="trees" pos="0.25" altPos="0.75" percent="0.67" />
		<objects id="ice_chest" start="0.2" end="0.5" count="3" tile="ice">
			this.inventory.addItems(Item.get("steel_bar"), 10); setBack(this.tile_x-offsetX, this.tile_y-offsetY, "snow");
		</objects>
		<objects id="ice_chest" start="0.2" end="0.5" count="1" tile="ice">
			this.inventory.addItems(Item.get("ice_arrow"), 6); setBack(this.tile_x-offsetX, this.tile_y-offsetY, "snow");
		</objects>
		<objects id="ice_chest" start="0.2" end="0.5" count="1" tile="ice">
			this.inventory.addItems(Item.get("ice_sword"), 1); setBack(this.tile_x-offsetX, this.tile_y-offsetY, "snow");
		</objects>
		<objects id="ice_chest" start="0.2" end="0.5" count="1" tile="ice">
			this.inventory.addItems(Item.get("hut_blueprint"), 1); setBack(this.tile_x-offsetX, this.tile_y-offsetY, "snow");
		</objects>
		<object id="yeti" x="48" y="-1" />
		<spawner id="yeti" time="4000" count="1" fromX="36" toX="58" fromY="-1" toY="-1" />
		<action>for(y in 0...16) for(x in 46...52) mine(x, y, 0);</action>
		<object id="mechanic.hotspot" x="32" />
	</area>
	<area id="science2.mid">
		<shape type="trapezoid" bottom="112">
			<top y="0" fromX="24" toX="104" />
			<bottom y="48" fromX="0" toX="128" />
		</shape>
		<tiles id="obsidian" start="0" end="0.5" empty="front|back" />
		<tiles id="bedrock" start="0.5" end="1" empty="front|back" />
		<tiles id="blackstone" y="111" />
		<ore id="quartz" start="0" end="0.5" percent="0.0375" tile="obsidian" />
		<ore id="diamond" start="0.25" end="0.5" percent="0.0125" tile="obsidian" />
		<ore id="titanium" start="0.5" end="0.8" percent="0.0125" tile="bedrock" />
		<ore id="uranium" start="0.75" end="1" percent="0.00625" tile="bedrock" />
		<set id="ar" value="[]" />
		<action>for(i in 1...9) ar.push("ship_debris"+i); shuffle(ar); for(i in 9...13) ar.push("ship_debris"+i);</action>
		<repeat count="ar.length"><objects id="ar.pop()" fromX="24" toX="104" fromY="-17" toY="0" width="4" height="2" count="1" bottom="true" layer="item" /></repeat>
	</area>
	<enemy id="underwater_trap" tile="wall_trap" type="trap" friendlyFire="false" fps="10" onWall="true">
		<attack type="projectile" damage="8" range="16">
			<projectile tile="fireball_small" animation="fireball_small.acid" glow="true" speed="3" delay="2" fire_sfx="fireball" hit_sfx="bolt_hit" knockback="5" underwater="true">
				<light tile="light.small" color="00cc00" />
			</projectile>
		</attack>
	</enemy>
	<area id="science2.maze">
		<setTile x="89" y="35" layer="back" tile="bedrock" /><setTile x="6" y="35" layer="back" tile="bedrock" />
		<setTile x="30" y="6" layer="back" tile="bedrock" /><setTile x="48" y="65" layer="back" tile="bedrock" />
		<maze floor="bedrock" wall="bedrock" width="16" height="12" tilesPerCell="6" />
		<objects id="underwater_trap" place="wall" length="8" fromX="0" toX="96" fromY="0" toY="72" count="32" />
		<action>for(y in -16...6) for(x in 30...36) mine(x, y, 0, (y == -16)?"sand_top":"sand"); for(y in 30...36) for(x in 89...121) mine(x, y, 0, "sand");</action>
		<action>for(x in 36...57) setBack(x, -16, "sand_top"); for(y in 30...36) for(x in -12...6) mine(x, y, 0, (x >= 0 &amp;&amp; y == 30)?"sand_top":"sand");</action>
		<action>for(y in 66...84) for(x in 48...54) mine(x, y, 0, "sand"); for(y in 78...84) for(x in 12...90) mine(x, y, 0, "sand");</action>
		<action>for(y in 0...96) for(x in -16...121) if(area.getTile(x+offsetX, y+offsetY, BASE_LAYER) == null &amp;&amp; area.getTile(x+offsetX, y+offsetY, BACK_LAYER) != null) area.setWater(x+offsetX, y+offsetY);</action>
		<action>for(y in 24...30) for(x in -12...0) mine(x, y, 0, (y == 24)?"sand_top":"sand");</action>
		<action>for(y in 72...78){for(x in 12...36) mine(x, y, 0, (y == 72)?"sand_top":"sand"); for(x in 66...90) mine(x, y, 0, (y == 72)?"sand_top":"sand");}</action>
		<object id="ship_chest" x="78" y="74">this.inventory.addItems(Item.get("silicon"), 10);</object>
		<object id="ship_chest" x="24" y="74">this.inventory.addItems(Item.get("uranium"), 1);</object>
		<object id="ship_chest" x="-6" y="26">this.inventory.addItems(Item.get("refined_oil"), 4);</object>
		<objects id="ship_chest" fromX="0" toX="96" fromY="0" toY="72" count="3" underwater="true" bottom="true">this.inventory.addItems(Item.get("torpedo"), 5);</objects>
		<objects id="ship_chest" fromX="0" toX="96" fromY="0" toY="72" count="4" underwater="true" bottom="true">this.inventory.addItems(Item.get("battery"), 2);</objects>
		<objects id="power_core_debris1" fromX="-12" toX="90" fromY="24" toY="78" count="2" />
		<objects id="power_core_debris2" fromX="-12" toX="90" fromY="24" toY="78" count="2" />
		<objects id="power_core_debris3" fromX="-12" toX="90" fromY="24" toY="78" count="2" />
		<objects id="power_core_debris4" fromX="-12" toX="90" fromY="24" toY="78" count="2" />
	</area>
	<action>function isBombardment(player){var o; return !player.getFlag('final_boss_defeat') &amp;&amp; (player.hasQuest('dragon_ship') || (player.getKillCount('ice_boss') > 0 &amp;&amp; player.hasQuest('go_east'))) &amp;&amp; (!player.getFlag('bombardment') || !player.areas.exists('start.orbit') || ((o = player.areas.get('start.orbit').getObject('alien.bomber')) != null &amp;&amp; o.enabled));}</action>
	<area id="science1" extends="science1">
		<connection area="science2" fromX="-250" toX="280" />
		<spawner id="jellyfish" time="5000" count="25" fromX="-100" toX="278" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<spawner id="kraken" time="50000" count="1" fromX="-200" toX="-50" fromY="10" toY="60" spawnWidth="256" spawnHeight="256" underwater="true" />
		<onLoad>
			<appendArea id="sea_floor" if="area.getObject('seaweed') == null"><params area_left="-250" area_right="330" area_width="192" area_height="96" /></appendArea>
			<objects structure="life_pod_debris2" width="3" height="8" fromX="-240" toX="-17" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod3" if="area.getStructureById('life_pod_debris2') == null" />
			<objects structure="life_pod_debris4" width="3" height="8" fromX="-240" toX="-17" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod5" if="area.getStructureById('life_pod_debris4') == null" />
			<objects structure="life_pod_debris3" width="3" height="8" fromX="209" toX="320" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod6" if="area.getStructureById('life_pod_debris3') == null" />
			<run procedure="bombardment.init" if="!getFlag('bombardment') && isBombardment(player)" />
			<section if="getFlag('bombardment')">
				<set id="current_area" value="area.id" />
				<music id="isBombardment(player) && !player.questComplete('bombardment_shield')?'encounter':'science1'" seconds="1" /><run procedure="science1.onLoad" />
				<run procedure="orbital_bombardment" /><stop />
			</section>
		</onLoad>
	</area>
	<area id="start" extends="start">
		<spawner id="jellyfish" time="5000" count="25" fromX="-100" toX="228" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<onLoad>
			<appendArea id="sea_floor" if="area.getObject('seaweed') == null"><params area_left="-240" area_right="280" area_width="128" area_height="96" /></appendArea>
			<objects structure="life_pod_debris1" width="3" height="8" fromX="-230" toX="-17" fromY="42" toY="78" underwater="true" bottom="true" count="1" dialogue="medicom.lifepod4" if="area.getStructureById('life_pod_debris1') == null" />
			<run procedure="bombardment.init" if="!getFlag('bombardment') && isBombardment(player)" />
			<section if="getFlag('bombardment')">
				<set id="current_area" value="area.id" />
				<music id="isBombardment(player) && !player.questComplete('bombardment_shield')?'encounter':'start'" seconds="1" />
				<run procedure="orbital_bombardment" /><stop />
			</section>
		</onLoad>
	</area>
	<area id="farming" extends="farming">
		<connection area="science2" fromX="280" toX="-240" />
	</area>
	<structure id="mirrow_jet_door" tile="ship_door" behind="true" remove="false">
		<tooltip id="enter" />
		<operate>
			<section if="area.id == 'science1'"><teleport area="water_cave" x="10" y="33" with="fade" /><stop /></section><set id="mdead" value="player.getNPC('mirrow_n.npc') == null" />
			<section if="mdead && player.getNPC('mechanic') == null">
				<section if="!getFlag('mirrows.steal_jet')">
					<dialogue section="mirrows" id="jet_door4" /><structure id="mirrow_jet_door" x="20" y="1" area="science1" />
					<object id="jet" x="20" area="science1" /><equip id="jet_engine" to="jet" fromInventory="false" />
					<action>jet.addFuel(500); setFlag('mirrows.steal_jet', true);</action>
				</section>
				<teleport area="science1" x="20" y="1" with="fade" /><dig x="20" y="1" speed="2" /><dig x="21" y="1" speed="2" /><dig x="20" y="0" speed="2" /><dig x="21" y="0" speed="2" /><stop />
			</section>
			<group>
				<dialogue section="mirrows" id="jet_door" />
				<dialogue section="mirrows" id="jet_door2" if="!mdead" />
				<dialogue section="mirrows" id="jet_door3" if="mdead" />
			</group>
		</operate>
		<over><action if="this.renderer != null">this.renderer.playAnimation("crashed_ship.door.opening", false)</action></over>
		<out><action if="this.renderer != null">this.renderer.playAnimation("crashed_ship.door.closing", false)</action></out>
	</structure>
	<area id="water_cave" extends="water_cave">
		<onLoad>
			<choose if="area.getNPC('mirrow_n.npc') != null">
				<structure id="mirrow_jet_door" x="10" y="33" if="area.getStructureById('mirrow_jet_door') == null && player.questComplete('ship_parts')" />
				<action if="area.getTileString(17, 30, BACK_LAYER) != 'ship'">
					for(y in 28...34) for(x in 10...24) setBack(x, y, 'ship'); for(x in 10...24){setTile(x, 28, 'ship'); setTile(x, 31, 'ship');}
				</action>
				<section if="area.getStructureById('sci1.light') == null">
					<structure id="sci1.light" x="12" y="33" /><structure id="sci1.light" x="16" y="33" /><structure id="sci1.light" x="20" y="33" />
					<structure id="sci1.light" x="12" y="30" /><structure id="sci1.light" x="16" y="30" /><structure id="sci1.light" x="20" y="30" />
				</section>
				<section if="area.getStructureById('medivat.full1') == null">
					<set id="ar" value="[12,15,18,21]" /><action>shuffle(ar);</action>
					<structure id="operation_table" x="13" y="33" />
					<structure id="medicom" x="22" y="33" dialogue="medicom.water_cave" />
					<structure id="medivat.full1" x="ar[0]" y="30" />
					<structure id="medivat.full2" x="ar[1]" y="30" />
					<structure id="medivat.full3" x="ar[2]" y="30" />
					<structure id="medivat.full4" x="ar[3]" y="30" />
					<object id="ship.bed.mirrows" x="13" y="30" />
					<object id="ship.bed.mirrows" x="16" y="30" />
					<object id="ship.bed.mirrows" x="19" y="30" />
				</section>
				<section if="area.getObject('ship.bed.mirrows') == null">
					<object id="ship.bed.mirrows" x="13" y="30" />
					<object id="ship.bed.mirrows" x="16" y="30" />
					<object id="ship.bed.mirrows" x="19" y="30" />
				</section>
			</choose>
			<event onMount="sub" once="true" if="!getFlag('build_sub')">
				<section if="!getFlag('build_sub') && area.getNPC('mirrow_n.npc') != null">
					<action>setFlag('build_sub', true)</action>
					<action if="player.areas.get('science1').getObject('kraken') == null">player.areas.get('science1').spawner.spawnAt("kraken", -80, 40);</action>
					<call id="mirrows" incoming="true"><caller id="mirrow_n" npc="mirrow_n.npc" /><caller id="mirrow_d" npc="mirrow_d.npc" /></call>
					<dialogue section="mirrows" id="build_sub1" speaker="mirrow_n" />
					<dialogue section="mirrows" id="build_sub2" speaker="mirrow_d" />
					<call id="mirrows" end="true" />
				</section>
			</event>
		</onLoad>
	</area>
	<include id="science3.xml" />
</data>