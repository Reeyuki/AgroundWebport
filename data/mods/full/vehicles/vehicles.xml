	<item id="sub" name="vehicle.submarine" type="object" cost="0" weight="100" icon="sub.ico" durability="500" durabilityName="common.health" durabilityIcon="vehicle_health">
		<action id="plant" name="vehicle.deploy" object="sub" onGrass="false" overlapBlueprints="true" overlapStructures="true" removeBushes="false" underwater="only">
			<action>
				object.setHealth(this.getFeed()); p = Item.getParameter(this.getNameStr(), "p");
				f = Item.getParameter(this.getNameStr(), "f"); if(f != null) object.setFuel(Std.parseInt(f));
				o = Item.getParameter(this.getNameStr(), "o"); if(o != null) object.loseOxygen(object.oxygen-Std.parseInt(o));
			</action>
			<equip eval="p" to="object" fromInventory="false" if="p != null" />
		</action>
		<action id="feed" alt="feed_all" alt_name="repair_all" name="repair" full="warning.max_repair" auto="common.auto_repair" select="actions.repair" sfx="workshop" />
