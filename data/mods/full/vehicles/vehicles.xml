	<vehicle id="sub" tile="sub" health="500" defense="4" speed="3" speedY="2" type="submarine" title="vehicle.submarine" fuel="2000" oxygen="200" max_weight="750" attack_move="true" death_sfx="explosion" accessObject="true" dive_sfx="submarine_submerge" walk_sfx="submarine_move" collect_sfx="submarine_arm" item="sub">
