		<repair id="titanium" value="250" />
		<onEmpty>
			<section if="player.hasContact('mirrows') && !getFlag('sub_empty')">
				<action>setFlag('sub_empty', true)</action>
				<call id="mirrows" incoming="true"><caller id="mirrow_d" npc="mirrow_d.npc" /></call>
				<dialogue section="mirrows" id="sub_empty1" speaker="mirrow_d" />
				<dialogue section="mirrows" id="sub_empty2" speaker="mirrow_d" />
				<call id="mirrows" end="true" />
			</section>
		</onEmpty>
		<listItem title="vehicle.pack_up">
			<closeWindows /><action>this.dismount();</action>
			<invokeLater><section if="player.vehicle == null">
				<action>player.inventory.addAll(this.inventory);</action><remove object="this" />
				<item id="sub" value="this.health"><parameter id="p" value="this.equipment.getItemId('attack')" /><parameter id="f" value="Std.string(this.fuel)" /><parameter id="o" value="Std.string(this.oxygen)" /></item>
