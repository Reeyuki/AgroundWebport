		<append tile="kraken" animation="kraken.eyes" />
	</animation>
	<animation id="kraken.hit" count="1" length="6">
		<append tile="kraken" animation="kraken.mouth.open" />
		<append tile="kraken" animation="kraken.eyes" />
	</animation>
	<animation id="kraken.bite" count="1" length="6">
		<append tile="kraken" animation="kraken.mouth.bite" />
		<append tile="kraken" animation="kraken.eyes" />
	</animation>
	<tile id="kraken.arm.back" sheet="kraken.1" x="9" />
