			<initRenderer><lerp object="this" seconds="2"><from rotation="-20" /><to rotation="20" /></lerp></initRenderer>
		</object>
		<object tile="kraken.arm.back" layer="bush" offsetY="57">
			<initRenderer><lerp object="this" seconds="2"><from rotation="90" /><to rotation="50" /></lerp></initRenderer>
		</object>
		<object tile="kraken.arm.back" layer="bush" offsetY="57">
			<initRenderer><lerp object="this" seconds="2"><from rotation="140" /><to rotation="180" /></lerp></initRenderer>
		</object>
		<object tile="kraken.arm.back" layer="bush" offsetY="57">
			<initRenderer><lerp object="this" seconds="2"><from rotation="250" /><to rotation="210" /></lerp></initRenderer>
		</object>
		<object offsetX="106" offsetY="10" width="44" height="50" overlapVehicle="true">
			<over>
				<damage object="player" attacker="this" damage="100" directional="false" critical="false" />
				<play object="this.parent" animation="bite" /><action if="this.parent.renderer != null">this.parent.renderer.playIdle(this.parent.renderer)</action>
			</over>
		</object>
		<hitbox x="106" y="111" width='44' height='10' />
