			<removed>
				<object id="boomerang.projectile" x="this.xPos/Tile.SIZE" y="this.yPos/Tile.SIZE" name="p" />
				<action>Movement.seek(p, player, 8); p.vars.set("spawner", player);</action>
			</removed>
		</projectile>
		<onEquip><action>getItem(this.info.id).xml.set('unequip', 'true');</action></onEquip>
