<?xml version="1.0" encoding="utf-8" ?>
<data>
	<include id="bg.xml" />
	<tile id="earth_moon" sheet="bg.1" />
	<procedure id="earth.parallax">
		<layer p="0" day="true"><rect color="95c6f4" x="0" y="0" width="256" height="144" /></layer>
		<layer p="0" day="false" storm="false" glow="true"><tile sheet="{core}/start/parallax/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" storm="false">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" storm="false">
			<clouds><tile id="cloud1" /><tile id="cloud2" /><tile id="cloud3" /></clouds>
		</layer>
		<layer p="0" storm="false" glow="moon">
			<tile id="earth_moon" rise="19" set="6" dir="left" pathHeight="96" pathTop="-16" />
		</layer>
		<layer p="0.03125" py="0.1875"><tile sheet="bg.2" x="2" /></layer>
		<layer p="0.046875" py="0.1875" scroll="0.0625"><tile sheet="{core}/start/parallax/tiles256.png" x="0" /></layer>
		<layer p="0.0625" py="0.25"><tile sheet="bg.2" x="1" loop="false" /></layer>
		<layer p="0.09375" py="0.375" scroll="0.125"><tile sheet="{core}/start/parallax/tiles256.png" x="1" dy="8" /></layer>
		<layer p="0.125" py="0.5"><tile sheet="bg.4" x="4" loop="false" /></layer>
		<layer p="0.125" py="0.5" scroll="0.0625" x="-100" width="296"><tile sheet="bg.4" x="0" /></layer>
	</procedure>
	<parallax id="earth" mapBG="1b6a9d" mapBGHeight="80" waterLevel="0">
		<run procedure="earth.parallax" />
		<layer p="0.25" py="0.75"><tile sheet="bg.4" x="2" loop="false" dy="8" /><tile sheet="bg.4" x="3" loop="false" offsetX="512" dy="8" /></layer>
		<layer p="0.25" py="0.75" scroll="0.125" x="-50" width="196"><tile sheet="bg.4" x="1" /></layer>
		<layer p="0.5" py="1"><tile sheet="bg.3" x="2" loop="false" dy="8" /></layer>
		<layer type="back" /><run procedure="start.water" />
	</parallax>
	<parallax id="earth.desert" mapBG="1b6a9d" mapBGHeight="80" waterLevel="0">
		<run procedure="earth.parallax" />
		<layer p="0.5" minLoop="2" maxLoop="3" py="1">
			<tile sheet="{core}/science1/parallax/bg320.png" x="1" dy="54" cap="left" />
			<tile sheet="{core}/science1/parallax/bg320.png" x="3" dy="54" cap="right" />
			<tile sheet="{core}/science1/parallax/bg320.png" x="2" dy="54" />
		</layer>
		<layer p="0.75" py="1">
			<tile sheet="{core}/science1/parallax/desert.png" x="0" y="0" offsetX="64" loop="false" offsetY="-26" />
			<tile sheet="{core}/science1/parallax/desert.png" x="0" y="2" offsetX="448" loop="false" offsetY="-26" />
			<tile sheet="{core}/science1/parallax/desert.png" x="0" y="1" offsetX="800" loop="false" offsetY="-26" />
        </layer>
		<run procedure="homeworld.parallax" if="onHomeworld(area, player)" />
		<layer type="back" /><run procedure="start.water" />
	</parallax>
	<parallax id="earth.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
			<tile id="earth_moon" rise="19" set="6" dir="left" pathHeight="96" pathTop="-16" />
		</layer>
		<layer p="0" py="0.0125" max_depth="10000"><tile sheet="bg.2" dy="22" /></layer>
		<layer p="0" py="0.0125" id="earth.ground" scroll="0.0078125" max_depth="10000"><tile sheet="bg.3" x="1" dy="22" /></layer>
		<layer p="0" py="0.0125" id="earth.clouds" scroll="0.03125" max_depth="10000"><tile sheet="bg.3" x="0" dy="22" /></layer>
		<layer type="back" />
	</parallax>
	
	<parallax id="mercury.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" py="0.0125" id="mercury.land" scroll="0.03125" max_depth="10000"><tile sheet="bg.3" x="6" dy="22" /></layer>
		<layer type="back" />
	</parallax>
	<parallax id="venus.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" py="0.0125" id="venus.land" scroll="0.03125" max_depth="10000"><tile sheet="bg.3" x="7" dy="22" /></layer>
		<layer type="back" />
	</parallax>
	<tile id="mars.deimos" sheet="bg.5" />
	<tile id="mars.phobos" sheet="bg.5" x="1" />
	<parallax id="mars.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
			<tile id="mars.deimos" rise="19" set="6" dir="left" pathHeight="96" pathTop="-16" />
			<tile id="mars.phobos" rise="20" set="23" dir="right" pathHeight="96" pathTop="-16" />
		</layer>
		<layer p="0" py="0.0125" id="mars.land" scroll="0.03125" max_depth="10000"><tile sheet="bg.3" x="5" dy="22" /></layer>
		<layer type="back" />
	</parallax>
	<tile id="mars.sky" sheet="{core}/start/parallax/night_bg.png" />
	<animation id="mars.sky" count="1" color="ff9933" colorScale="1.5" />
	<parallax id="mars" mapBG="0" skyColor="0">
		<layer p="0" day="true"><tile id="mars.sky" animation="mars.sky" /></layer>
		<layer p="0" day="false" glow="true"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" storm="false" glow="moon">
			<tile id="mars.deimos" rise="19" set="6" dir="left" pathHeight="96" pathTop="-16" />
			<tile id="mars.phobos" rise="20" set="23" dir="right" pathHeight="96" pathTop="-16" />
		</layer>
		<layer p="0.0625" py="0.25"><tile sheet="bg.2" x="3" /></layer>
		<layer p="0.125" py="0.5"><tile sheet="bg.4" x="5" /></layer>
		<layer p="0.1875" py="0.625"><tile sheet="bg.3" x="4" /></layer>
		<layer p="0.5" py="1"><tile sheet="bg.6" x="0" /></layer>
		<layer type="back" />
	</parallax>
	<parallax id="jupiter.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" py="0.0125" id="jupiter.land" scroll="0.03125" max_depth="10000"><tile sheet="bg.3" x="3" dy="22" /></layer>
		<layer type="back" />
	</parallax>
</data>