		<tiles id="sand" start="0.0625" end="0.3" /><tiles id="sand_top" top="0" includeShape="false" />
		<mine start="0.0625" end="0.125" /><mine start="0.3125" end="0.375" />
		<tiles id="basalt" start="0.3" end="0.6" /><tiles id="obsidian" start="0.6" end="1" />
		<action>
			var r_area = areas.get("earth.ruins");
			var ruins = []; for(i in 0...9) ruins.push(i); shuffle(ruins); var widths = []; var total = 0.0;
			for(i in 0...ruins.length){var v = getTile("earth.ruins"+ruins[i]).getInnerBounds().width/Tile.SIZE; widths.push(v); total += Math.ceil(v);}
			var ar = []; var sx = 0; var sz = Math.round((256-total)/10); for(i in 0...ruins.length){
				ar.push(sx); sx += sz; ar.push(sx); sx += Math.ceil(widths[i]);
			} ar.push(sx); ar.push(255); var i = 1; var idx = 0;
			function _setTile(x, y, t){setTile(x, y, t); setBack(x, y, null);} var dcount = 0; var pos = [5, 33, 61];
			while(i+1 &lt; ar.length){
				var sy = randInt(-10, 10); var w = widths[idx]; var ri = ruins[idx];
				var d = getStructure("earth.ruins"+ri).build(null, area, Math.floor((ar[i]-16+(Math.ceil(w)-w)*0.5)*Tile.SIZE), (sy-1)*Tile.SIZE);
				if(ri >= 6){
					if(dcount == 1){
						var b = d.getInnerBounds(false); d.info.modifyHitbox(b);
						var o = ObjectInfo.make("scavenger.distress", Math.round(b.x+(b.width-Tile.SIZE)*0.5), d.yPos); area.addObject(o);
					} d.area_id = "earth.ruins"; d.x = pos[dcount]*Tile.SIZE; d.y = 5*Tile.SIZE; dcount++;
					var de = getStructure("earth.door").build(null, r_area, d.x, d.y);
					var b = d.getInnerBounds(false); d.info.modifyHitbox(b);
					de.area_id = area.id; de.x = Math.round(b.x+(b.width-Tile.SIZE)*0.5); de.y = d.yPos;
				} for(y in sy...20) for(x in ar[i]...ar[i+1]) _setTile(x-16, y, "concrete"); idx++; i += 2;
			} for(y in 20...40) for(x in 0...256) _setTile(x-16, y, "concrete");
			for(y in 40...96){_setTile(-16, y, "bedrock"); _setTile(255-16, y, "bedrock");}
			for(y in 28...33) for(x in -16...240){_setTile(x, y, "subway"); if(y != 28 &amp;&amp; y != 32) mine(x, y);}
			for(x in 0...64) getStructure("subway.section").build(null, area, (x*4-16)*Tile.SIZE, 31*Tile.SIZE);
            var ar = []; var x = randInt(4, 8); while(x &lt; 60){ar.push(x); x += randInt(4, 8);}
            var len = (ar.length-5)>>1; var caveins = []; var doors = []; var last = 0; for(i in 0...len){
                var to = Math.round((i+1)*ar.length/(len+1)); var dar = []; for(j in last...to) dar.push(ar[j]); doors.push(dar); last = to+1; caveins.push(ar[to]);
            } var dar = []; for(j in last...ar.length) dar.push(ar[j]); doors.push(dar);
			var o = ObjectInfo.make("ship_chest", -15*Tile.SIZE, 31*Tile.SIZE); o.inventory.addItems(Item.get("disabled_keycard"), 1); area.addObject(o);
			var o = ObjectInfo.make("ship_chest", (63*4-14)*Tile.SIZE, 31*Tile.SIZE); o.inventory.addItems(Item.get("disabled_keycard"), 1); area.addObject(o);
			for(dar in doors) shuffle(dar); var left = doors[0].shift(); var right = doors[doors.length-1].shift();
            for(x in caveins) getStructure("subway.cavein").build(null, area, (x*4-16)*Tile.SIZE, 31*Tile.SIZE);
            var d = getStructure("subway.door").build(null, area, (left*4-16)*Tile.SIZE, 31*Tile.SIZE);
            d.area_id = area.id; d.x = Math.round((right*4-14.5)*Tile.SIZE); d.y = 31*Tile.SIZE;
            var d = getStructure("subway.door").build(null, area, (right*4-16)*Tile.SIZE, 31*Tile.SIZE);
            d.area_id = area.id; d.x = Math.round((left*4-14.5)*Tile.SIZE); d.y = 31*Tile.SIZE;
            for(i in 0...3){
				var di = (i == 0)?0:(i == 1?randInt(1, doors.length-1):doors.length-1);
				var d = getStructure("subway.door").build(null, area, (doors[di].shift()*4-16)*Tile.SIZE, 31*Tile.SIZE);
				d.area_id = "earth.ruins"; d.x = pos[i]*Tile.SIZE; d.y = 39*Tile.SIZE;
				var de = getStructure("earth.door").build(null, r_area, d.x, d.y);
				de.area_id = area.id; de.x = d.xPos+Tile.SIZE; de.y = d.yPos;
			} for(dar in doors) for(d in dar) getStructure("subway.door.broken").build(null, area, (d*4-16)*Tile.SIZE, 31*Tile.SIZE);
		</action>
