<?xml version="1.0" encoding="utf-8" ?>
<data>
	<action>
		function unequipAll(e, o, incUnequip){
			for(s in e.getSlots()){
				e.unequip(s, o); if(incUnequip &amp;&amp; e.getItem(s) != null) e.forceEquip(s, o);
			}
		}
	</action>
	<procedure id="changePlayerForm"><action>
		unequipAll(player.equipment, player, true); unequipAll(player.vanity, player, true); var old = player; changePlayer(id); player.experience = old.experience;
		copyMap(old.stickyItems, player.stickyItems); copyMap(old.seen_items, player.seen_items); player.inventory.copyFrom(old.inventory);
		var len = old.hotkeys.length; for(i in 0...len) player._setHotkey(i, old.hotkeys[i]);
		for(p in old.stats) if(p.perma_buff != 0){var s = player.stats.get(p.id); s.permaBuff(p.perma_buff-s.perma_buff);}
		for(s in old.skills.skills.keys()) player.skills.set(s, old.skills.get(s)); player.fullRestore();
	</action></procedure>
	
	<procedure id="player.werewolf">
		<action>
			s = player.createSimpleSprite('idle'); id = "player.werewolf"; var r = player.renderer; s.x = r.x; s.y = r.y; s.scaleX = r.scaleX;
			if(!player.offsets.exists("werewolf_hair")){var ar = getOffsets("werewolf_hair"); player.offsets.set("werewolf_hair", ar[player.offsets.get("hair").hidden?ar.length-1:0].offset);}
			var s = player.stats.get("speed"); if(s.perma_buff &lt; 4) s.permaBuff(4-s.perma_buff);
		</action>
		<run procedure="changePlayerForm" />
		<action>
			player.equipment.forceEquip("weapon", player, getItem("werewolf_paws").asItem());
			player.equipment.forceEquip("armor", player, getItem("werewolf_body").asItem());
			player.equipment.forceEquip("head", player, getItem("werewolf_head").asItem());
			var r = player.renderer; r.scaleX = s.scaleX; r.alpha = 0; r.parent.addChild(s);
		</action>
		<lerp object="s" alpha="0" seconds="1" modal="false" /><lerp object="player" alpha="1" seconds="1" modal="false" /><invokeLater><action>s.parent.removeChild(s);</action></invokeLater>
	</procedure>
	
