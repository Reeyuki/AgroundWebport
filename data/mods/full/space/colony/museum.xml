	<tile id="hoarder_backpack" sheet="equip.png" x="74" offsetX="8" />
	<animation id="equipment.hoarder_backpack.idle" equals="single" />
	<item id="hoarder_backpack" type="tool" slot="back" action="equip" cost="0" weight="5" capacity="1200" icon="hoarder_backpack.ico" />
	<action>curator_rewards = ['hoarder_hat', 'hoarder_gun', 'hoarder_armor', 'hoarder_backpack', 'hoarder_shield'];</action>
	<npc id="curator" tile="curator" action="talk" talk_sfx="talking4" night="true">
		<idle class="wander" toX="7" />
		<operate>
			<section if="!getFlag('curator_intro')">
				<action>setFlag('curator_intro', true);</action><quest />
				<scene id="colony" show="museum" with="fade" showToAll="true" />
			</section>
			<section>
				<action>
					count = 0; total = 0; reward = null;
					for(s in area.getStructuresById("museum.case")){
						total++; if(Item.getParameter(s.name, 'c') == '0') count++;
					} ct = 0; for(i in curator_rewards){
						ct++; if(count &lt; ct*10) break;
						if(!player.seen_items.exists(i)){reward = i; break;}
					}
				</action>
				<section if="count == 0"><dialogue section="museum" id="curator4" speaker='this' /><stop /></section>
				<dialogue eval="'museum.curator_complete{count:'+count+'}{total:'+total+'}'" speaker="this" />
				<choose>
					<section if="reward != null">
						<dialogue eval="ct == 5?'museum.curator_reward_complete':'museum.curator_reward{count:'+(ct*10)+'}'" speaker="this" />
						<item eval="reward" />
					</section>
					<group>
						<choose>
							<dialogue section="museum" id="curator_all" speaker='this' if="count == total" />
							<dialogue section="museum" id="curator_50" speaker='this' if="count >= 40" />
							<dialogue section="museum" id="curator_40" speaker='this' if="count >= 30" />
							<dialogue section="museum" id="curator_30" speaker='this' if="count >= 20" />
							<dialogue section="museum" id="curator_20" speaker='this' if="count >= 10" />
							<dialogue section="museum" id="curator_10" speaker='this' />
						</choose>
						<section if="count >= 10">
							<dialogue section="museum" id="buy1" speaker='this' />
							<window type="shop" title="museum.buy">
								<action>
									for(i in curator_rewards) if(player.seen_items.exists(i)) evalXml("&lt;item id='"+i+"' cost='50000' /&gt;");
								</action>
							</window>
						</section>
					</group>
				</choose>
			</section>
		</operate>
	</npc>
	<structure id="colony.museum.bg" image="museum_bg.png" width="368" height="272" priority="-2" back="true" remove="false" />
