	<animation id="colony.museum.computer.idle" x="37" count="10" offsetY="-16" /><structure id="colony.museum.computer" tile="earth.doodad" animation="colony.museum.computer" name="read" height="16" remove="false" />
	<structure id="colony.museum.mined" extends="colony.museum.computer">
		<operate><action>ct = 0; for(v in player.state.tiles) ct += v;</action><dialogue eval="'museum.mined{count:'+Utils.addCommas(ct)+'}'" /></operate>
	</structure>
	<structure id="colony.museum.killed" extends="colony.museum.computer">
		<operate><action>ct = 0; for(v in player.state.enemies) ct += v;</action><dialogue eval="'museum.killed{count:'+Utils.addCommas(ct)+'}'" /></operate>
	</structure>
	<structure id="colony.museum.crops" extends="colony.museum.computer">
		<operate><action>ct = 0; for(a in player.areas) for(s in a.getStructures()) if(s.info.xml.nodeName() == "crop") ct++;</action><dialogue eval="'museum.crops{count:'+Utils.addCommas(ct)+'}'" /></operate>
	</structure>
	<structure id="colony.museum.caught" extends="colony.museum.computer">
		<operate><action>ct = 0; for(f in player.state.flags.keys()) if(f.substring(0,8) == "capture.") ct++;</action><dialogue eval="'museum.caught{count:'+Utils.addCommas(ct)+'}'" /></operate>
	</structure>
	<structure id="colony.museum.read" extends="colony.museum.computer">
		<operate><action>ct = 0; for(f in player.state.flags.keys()) if(f.substring(f.length-5,f.length) == ".read") ct++;</action><dialogue eval="'museum.read{count:'+Utils.addCommas(ct)+'}'" /></operate>
	</structure>
