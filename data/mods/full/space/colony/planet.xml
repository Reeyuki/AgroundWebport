<?xml version="1.0" encoding="utf-8" ?>
<data>
	<animation id="planet.colony">
		<append tile="planet6" animation="single" color="5380a5" colorScale="2" />
		<append tile="planet6.land2" animation="single" color="abaa5b" colorScale="2" />
		<append tile="planet6.clouds" animation="single" />
		<append tile="planet6.shadow" animation="single" /><frame visible="false" />
	</animation>
	<planet id="colony" height="80">
		<orbit id="colony.orbit" width="256" height="64" background="colony.orbit" name="system.planet.colony_orbit" type="none" stationMusic="colony">
			<area id="colony" x="0" />
			<area id="colony.mainland" x="84" />
			<structure id="colony_ship" x="103" y="44" />
			<structure id="hydroponics" x="132" y="38" area="colony.orbit.station"><addAnimal id="wheat_seed" count="1" /></structure>
			<structure id="hydroponics" x="136" y="38" area="colony.orbit.station"><addAnimal id="wheat_seed" count="1" /></structure>
			<structure id="hydroponics" x="140" y="38" area="colony.orbit.station"><addAnimal id="wheat_seed" count="1" /></structure>
			<structure id="bunker_depot" x="114" y="42" area="colony.orbit.station" />
			<structure id="blueprint_printer" x="112" y="17" area="colony.orbit.station" />
			<structure id="paper_maker" x="114" y="17" area="colony.orbit.station" />
			<objects id="colony.townfolk" count="7" fromX="127" toX="140" fromY="23" toY="27" area="colony.orbit.station" />
			<object id="npc_patrol_bot" x="110" y="18" area="colony.orbit.station" />
			<object id="npc_patrol_bot" x="140" y="40" area="colony.orbit.station" />
			<object id="npc_bot.carry" x="140" y="35" area="colony.orbit.station" />
			<object id="npc_bot.carry" x="114" y="42" area="colony.orbit.station" />
			<object id="npc_bot.farmer" x="132" y="38" area="colony.orbit.station" />
			<object id="npc_bot.farmer" x="140" y="38" area="colony.orbit.station" />
			<object id="president" x="110" y="20" area="colony.orbit.station" />
			<objects id="pilot" count="1" fromX="127" toX="140" fromY="23" toY="27" area="colony.orbit.station" />
			<init><runAreaLoad /></init>
			<onLoad><music id="orbit" seconds="1" /><radar tile="orbit.radar" animation="orbit.radar" padding="2" /><achievement id="colony" /></onLoad>
		</orbit>
	</planet>
	<system id="colony" bgm="voyage" x="60" y="110" available="getFlag('colony_world')">
		<planet id="colony" tile="planet6" animation="planet.colony" orbit="orbit3" orbitOffX="-20" orbitOffY="-23" offsetX="13" offsetY="15" name="system.planet.colony" />
	</system>
	
	<include id="parallax.xml" includeRoot="true" /><include id="parallax256.xml" includeRoot="true" />
	<procedure id="homeworld.parallax">
		<layer p="0.75" py="1">
			<tile sheet="{mod:full_version}/space/colony/parallax256.png" x="15" offsetX="300" loop="false" />
			<tile sheet="{mod:full_version}/space/colony/parallax256.png" x="17" offsetX="750" loop="false" />
		</layer>
		<layer p="0.75" py="1" glow="true">
			<tile sheet="{mod:full_version}/space/colony/parallax256.png" x="16" offsetX="300" loop="false" />
			<tile sheet="{mod:full_version}/space/colony/parallax256.png" x="18" offsetX="750" loop="false" />
		</layer>
	</procedure>
	<tile id="homeworld.bg" sheet="parallax256.png" x="3" />
	<animation id="homeworld.bg" x="-1" count="1" length="12"><append tile="homeworld.bg" animation="item12" /></animation>
	<animation id="sun.colony" count="10" color="ff99bb" />
	<parallax id="colony" mapBG="1b6a9d" mapBGHeight="80" waterLevel="0">
		<layer p="0" day="true">
			<tile sheet="{core}/start/parallax/bg.png" x="0" y="0" />
			<rect color="438a9e" x="0" y="80" width="256" height="64" />
		</layer>
		<layer p="0" day="false" storm="false" glow="true">
			<tile sheet="{core}/start/parallax/night_bg.png" x="0" y="0" />
		</layer>
		<layer p="0" storm="false">
			<tile id="sun" animation="sun.colony" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" storm="false">
			<clouds><tile id="cloud1" /><tile id="cloud2" /><tile id="cloud3" /></clouds>
		</layer>
		<layer p="0.0625" py="0.2" scroll="0.03125" x="-100" width="328"><tile sheet="{mod:full_version}/science2/parallax/clouds.png" x="0" dy="-64" /></layer>
		<layer p="0.0625" py="0.25"><tile sheet="parallax256.png" x="1" loop="false" offsetX="128" /></layer>
		<layer p="0.09375" py="0.375" scroll="0.125"><tile sheet="{core}/start/parallax/tiles256.png" x="1" dy="8" /></layer>
		<layer p="0.125" py="0.4" scroll="0.0625" x="-100" width="328"><tile sheet="{mod:full_version}/science2/parallax/clouds.png" x="3" dy="-128" /></layer>
		<layer p="0.125" py="0.75"><tile sheet="parallax.png" x="3" loop="false" /></layer>
		<layer p="0.25" py="0.8" scroll="0.125" x="-100" width="328"><tile sheet="{mod:full_version}/science2/parallax/clouds.png" x="2" dy="-256" /></layer>
		<layer p="0.25" py="1"><tile sheet="parallax.png" x="2" loop="false" dy="5" offsetX="64" /></layer>
		<run procedure="homeworld.parallax" if="onHomeworld(area, player)" />
		<layer type="back" /><run procedure="start.water" />
		<layer top="true" p="1" py="1" scroll="0.25" x="-100" width="328" alpha="0.75"><tile sheet="{mod:full_version}/science2/parallax/clouds.png" x="1" dy="-320" /></layer>
	</parallax>
	<parallax id="colony.orbit" mapBG="0" skyColor="0">
		<layer p="0" glow="true" max_depth="10000"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>
		<layer p="0" glow="true" max_depth="10000">
			<tile id="sun" animation="sun.colony" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>
		<layer p="0" py="0.0125" max_depth="10000"><tile sheet="parallax256.png" x="0" dy="22" /></layer>
		<layer p="0" py="0.0125" id="colony.ground" scroll="0.0078125" max_depth="10000"><tile sheet="parallax.png" x="1" dy="22" /></layer>
		<layer p="0" py="0.0125" id="colony.clouds" scroll="0.03125" max_depth="10000"><tile sheet="parallax.png" x="0" dy="22" /></layer>
		<layer type="back" />
	</parallax>
</data>