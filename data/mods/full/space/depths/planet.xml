			<top y="0" fromX="4" toX="26" />
			<bottom y="10" fromX="0" toX="38" />
		</shape>
		<tiles id="sand" start="0" end="1" />
		<tiles id="sand_top" top="0" />
		<structure id="light_weed1" x="11" />
		<structure id="depths.monolith.off" x="16.5" />
	</area>
	<area id="depths" width="64" height="96" background="depths" planet="depths" name="system.planet.depths">
		<shape type="trapezoid">
			<top y="-10" fromX="30" toX="46" />
			<bottom y="0" fromX="20" toX="56" />
		</shape>
		<tiles id="depths.dirt" start="0" end="0.5" />
		<tiles id="depths.stone" start="0.5" end="1" />
		<tiles id="depths.grass" top="0" />
		<shore x="-1" top="sand_top" bottom="sand" trans1="depths.dirt_sand1" trans2="depths.dirt_sand2" flip="true" dock="dock_empty" />
		<shore x="64" top="sand_top" bottom="sand" trans1="depths.dirt_sand1" trans2="depths.dirt_sand3" dock="dock_empty_flip" />
		<set id="_width" value="192" /><set id="_height" value="92" /><appendArea id="depths.shallows.left" offsetX="-196" offsetY="4" />
		<set id="_width" value="187" /><set id="_height" value="92" /><appendArea id="depths.shallows.right" offsetX="68" offsetY="4" />
		<appendArea id="depths.maze" offsetX="-196" offsetY="96" />
		<appendArea id="depths.trench" offsetX="-336" offsetY="160" />
		<appendArea id="depths.trench.island" offsetX="-282" offsetY="69" />
		<action>
			for(y in 96...112){for(x in 84...304) setTile(x, y, "blackstone"); for(x in -368...-336) setTile(x, y, "blackstone");}
			for(y in 112...192) for(x in -352...-336) setTile(x, y, "blackstone"); for(x in -336...-196) setTile(x, 191, "blackstone");
			for(y in 176...192) for(x in -196...-186) setTile(x, y, "blackstone");
		</action>
