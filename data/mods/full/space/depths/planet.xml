		<structure id="depths.monolith.off" x="256" y="95" />
		<structure id="sub_pen" x="-8" />
		<objects structure="light_weed1" width="2" height="6" count="2" fromX="-192" toX="-128" fromY="50" toY="90" underwater="true" bottom="true" />
		<objects structure="light_weed2" width="2" height="6" count="2" fromX="-196" toX="-128" fromY="50" toY="90" underwater="true" bottom="true" />
