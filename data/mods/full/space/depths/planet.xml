		<spawner id="metal_debris1" time="5000" count="20" fromX="-196" toX="-6" fromY="3" toY="62" underwater="true" />
		<objects id="metal_debris2" width="4" height="2" count="2" fromX="-196" toX="-6" fromY="20" toY="90" underwater="true" />
		<objects id="metal_debris3" width="4" height="2" count="2" fromX="-196" toX="-6" fromY="20" toY="90" underwater="true" />
		<objects id="metal_debris4" width="4" height="2" count="2" fromX="-196" toX="-6" fromY="20" toY="90" underwater="true" />
