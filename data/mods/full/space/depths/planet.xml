		<objects id="metal_debris7" width="4" height="2" count="2" fromX="-196" toX="-6" fromY="20" toY="90" underwater="true" />
		<objects structure="depths.tablet" width="1" height="2" fromX="-196" toX="176" fromY="30" toY="90" underwater="true" bottom="true" count="9" dialogue="'depths.tablet'+count" />
		<spawner id="brutefish" time="5000" count="18" fromX="-320" toX="240" fromY="3" toY="78" spawnWidth="128" underwater="true" />
		<spawner id="jellypod" time="8000" count="12" fromX="-320" toX="240" fromY="3" toY="78" spawnWidth="128" underwater="true" />
