		<spawner id="lampfish" time="5000" count="6" fromX="-320" toX="-196" fromY="140" toY="180" spawnWidth="128" underwater="true" />
		<connection area="depths" fromX="276" toX="-352" />
		<connection area="depths" fromX="-352" toX="276" />
		<fishing>
			<loot id="toothfish" p="8" difficulty="1" />
			<loot id="rockfish" p="12" difficulty="2" />
			<loot id="coral_cod" p="1" difficulty="3" />
		</fishing>
		<init><runAreaLoad /><action>area.spawner.spawnAll("brutefish"); area.spawner.spawnAll("jellypod"); area.spawner.spawnAll("snaptopus"); area.spawner.spawnAll("sea_serpent"); area.spawner.spawnAll("lampfish"); area.spawner.spawnAll("scale_fish"); area.spawner.spawnAll("blue_crab"); area.spawner.spawnAll("metal_debris1");</action></init>
		<onLoad>
			<music id="depths" seconds="1" />
			<section if="area.getStructureById('cave') == null">
				<set id="cave_x" value="randInt(2, 62)" />
				<structure id="cave" x="cave_x" y="62">
					<teleport area="depths.cave" x="32" y="32" allowReturn="true" />
				</structure>
				<spreadTiles x="cave_x" y="62" eval="'markings'+randInt(1,9)" layer="back" on="depths.stone" count="50" />
			</section>
		</onLoad>
	</area>
		
	<area id="depths.cave" width="64" height="64" background="black" temporary="true">
		<tiles id="depths.stone" start="0" end="1" />
		<tiles id="depths.dirt" start="0.1" end="0.3" />
		<mine start="0.45" end="0.55" />
		<tiles id="blackstone" y="0" />
		<tiles id="blackstone" y="63" />
		<tiles id="blackstone" x="0" />
		<tiles id="blackstone" x="63" />
		<ore id="coal" start="0.1" end="0.3" percent="0.0125" tile="depths.dirt" />
		<ore id="quartz" start="0.1" end="0.3" percent="0.00625" tile="depths.dirt" />
		<ore id="moissanite" start="0" end="1" percent="0.0125" tile="depths.stone" />
		<ore id="magnegem" start="0.7" end="1" count="20" tile="depths.stone" />
		<ore id="diamond" start="0.6" end="1" percent="0.00625" tile="depths.stone" />
		<ore id="titanium" start="0.75" end="1.0" percent="0.00625" tile="depths.stone" />
		<objects id="golem_end" start="0.0" end="1.0" count="10" />
		<structure id="cave" x="32" y="32" />
		<mine x="32" y="32" light="3" /><mine x="33" y="32" light="3" /><mine x="32" y="31" light="3" /><mine x="33" y="31" light="3" />
		<set id="pillar_x" value="randInt(4, 59)" />
		<set id="pillar_y" value="randInt(6, 57)" />
		<spreadTiles x="pillar_x" y="pillar_y" tile="invisible_block" count="100" />
		<structure id="recipe_pillar" x="pillar_x" y="pillar_y" recipe="make_water_axe" />
	</area>
		
	<tile id="depths.monolith" sheet="objects.7" />
	<animation id="depths.monolith.off.idle" equals="single" />
	<animation id="depths.monolith.idle" x="1" count="1" />
	<animation id="depths.monolith.over" x="2" count="6" />
	<structure id="depths.monolith.off" tile="depths.monolith" name="activate" submarine="true">
		<operate><set id="achievement" value="null" /><set id="gem" value="'bone_shard'" /><set id="into" value="'depths.monolith'" /><set id="sfx" value="null" /><run procedure="activate.gem_structure" /></operate>
	</structure>
	<structure id="depths.monolith" tile="depths.monolith" submarine="true" overlapVehicle="true" includeName="true" removeButton="structure.uproot">
		<tooltip section="structure" id="uproot" if="player.vehicle != null" />
		<tooltip id="operate" />
		<addedToArea><action>if(built) player.state.fireStateUpdated();</action></addedToArea>
		<operate>
			<section if="player.vehicle != null"><window type="prompt" message="structure.ask_uproot"><action>this.removeStructure(player)</action></window><stop /></section>
			<window type="portal" structure="depths.monolith">
				<action with="ellipse">player.teleportTo(portal_area, portal_x, portal_y);</action>
				<listItem title="actions.rename">
					<closeWindows /><window type="input" initial="this.name" message="world.rename" maxLength="30">
						<action>this.name=result;</action>
					</window>
				</listItem>
				<functionButton title="structure.uproot"><action>this.removeStructure(player)</action></functionButton>
			</window>
		</operate>
		<over><action>this.loopAnimation("over")</action></over>
		<out><action>this.loopAnimation("idle")</action></out>
		<removeBy><action>this.onDismantle(player); player.addItem("monolith_seed");</action></removeBy>
	</structure>
	<item id="monolith_seed" type="potion" cost="0" weight="10" icon="storehouse_seed.ico" animation="item20">
		<action id="plant" sfx="plant_seed" structure="depths.monolith" onGrass="false" underground="true" underwater="true" buildTime="15">
			<areaConstraint enabled="!player.inDungeon() && !player.inTempArea()" fail="warning.no_place" />
			<plantCost><item id="bone_shard" count="1" /></plantCost>
		</action>
	</item>
	<tile id="depths.summit" sheet="objects.8" />
	<structure id="depths.summit" tile="depths.summit" />
	<tile id="depths.tablet" sheet="objects.9" />
	<animation id="depths.tablet.idle" equals="single" />
	<animation id="depths.tablet.over" x="1" count="6" />
	<structure id="depths.tablet" tile="depths.tablet" name="read" type="dialogue" submarine="true" overlapVehicle="true">
		<over><action>this.loopAnimation("over")</action></over>
		<out><action>this.loopAnimation("idle")</action></out>
	</structure>
</data>